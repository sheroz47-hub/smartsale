# Файлы, которые исполняются на Linux, должны приезжать туда с LF. Скрипт,
# побывавший на Windows, иначе приходит с CRLF, и система жалуется на
# несуществующий интерпретатор.
*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.kt      text eol=lf
*.kts     text eol=lf
*.gradle  text eol=lf
*.toml    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
gradlew   text eol=lf
