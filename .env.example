# Скопировать в .env на сервере, права 600. В репозиторий .env не попадает.

DATABASE_URL=postgresql+psycopg://smartsale@/smartsale

# Подпись сессионных кук и токенов устройств. Обязательно задать своё:
# при смене все разлогиниваются, при пустом — вход небезопасен.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Сколько живёт сессия веб-кабинета без активности, часов.
SESSION_HOURS=12

# Сколько живёт токен мобильного устройства, суток. Агент в поле не должен
# логиниться каждый день, поэтому срок длинный; отзыв — через отключение
# устройства в бэкофисе.
DEVICE_TOKEN_DAYS=90

# Валюта и точность сумм. Узбекский сум дробной части на практике не имеет.
CURRENCY=UZS
AMOUNT_SCALE=2

# Требовать координаты при отметке визита. Выключено — телефоны без GPS
# и подвалы магазинов иначе блокируют работу.
REQUIRE_VISIT_GPS=0

# Максимальный размер пакета синхронизации, записей на сущность.
SYNC_PAGE_SIZE=1000

# --- обмен с УТ (приём справочников и акций) ---
# Адрес HTTP-сервиса расширения УТ (без завершающего /), логин и пароль 1С
# для Basic, токен канала (X-SmartSale-Token). Заполнить на сервере.
UT_BASE_URL=http://5.133.120.66:49900/ut_milk/hs/smartsale
UT_LOGIN=smartsale
UT_PASSWORD=
UT_TOKEN=
UT_TIMEOUT=60
