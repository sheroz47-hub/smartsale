// Виды цен, пригодные для продажи. Тот же отбор применяется к ценам:
// иначе в /prices приехали бы ссылки на виды цен, которых нет в /meta.
Функция ВидыЦен()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрВидыЦен.Ссылка) КАК УИД,
	|	СпрВидыЦен.Наименование КАК Наименование,
	|	СпрВидыЦен.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ЕСТЬNULL(СпрВидыЦен.ВалютаЦены.Наименование, """") КАК Валюта
	|ИЗ
	|	Справочник.ВидыЦен КАК СпрВидыЦен
	|ГДЕ
	|	СпрВидыЦен.ИспользоватьПриПродаже
	|	И НЕ СпрВидыЦен.ПометкаУдаления
	|	И СпрВидыЦен.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДействияВидовЦен.Действует)
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("price_includes_vat", Выборка.ЦенаВключаетНДС);
		Элемент.Вставить("currency", СокрЛП(Выборка.Валюта));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Менеджеры, закреплённые за клиентами.
//
// Список строится от клиентов, а не от справочника пользователей. Отличить
// здесь торгового агента от администратора нельзя: основным менеджером
// части партнёров стоит администратор. Кто из них агент, решает уже
// принимающая сторона — поэтому и «менеджеры», а не «агенты».
Функция Менеджеры()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрПартнеры.ОсновнойМенеджер) КАК УИД,
	|	ЕСТЬNULL(СпрПартнеры.ОсновнойМенеджер.Наименование, """") КАК Наименование,
	|	НЕ ЕСТЬNULL(СпрПартнеры.ОсновнойМенеджер.Недействителен, ЛОЖЬ) КАК Активен
	|ИЗ
	|	Справочник.Партнеры КАК СпрПартнеры
	|ГДЕ
	|	СпрПартнеры.Клиент
	|	И НЕ СпрПартнеры.ПометкаУдаления
	|	И СпрПартнеры.ОсновнойМенеджер <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("active", Выборка.Активен);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Учётки агентов для входа в приложение: логин и временный пароль из регистра
// SmartSale_СкладыАгентов. Отдаются только строки с заполненным логином —
// у кого логина нет, тот в приложение не входит. Сервер SmartSale выставит
// агенту логин и хеш пароля. Пароль идёт в открытом виде под токеном канала;
// на бою канал переводится на HTTPS.
Функция УчёткиАгентов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СклАг.Пользователь) КАК УИД,
	|	СклАг.Логин КАК Логин,
	|	СклАг.Пароль КАК Пароль
	|ИЗ
	|	РегистрСведений.SmartSale_СкладыАгентов КАК СклАг
	|ГДЕ
	|	СклАг.Логин <> """"";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("login", СокрЛП(Выборка.Логин));
		Элемент.Вставить("password", Выборка.Пароль);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Маршруты агентов: по каким клиентам агент ходит в какой день недели.
// Ведётся в УТ (регистр SmartSale_Маршруты). Сервер SmartSale строит из этого
// маршрут по дням, приложение показывает список точек на выбранный день.
Функция МаршрутыАгентов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(М.Пользователь) КАК УИДАгента,
	|	М.ДеньНедели КАК ДеньНедели,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(М.Партнер) КАК УИДКлиента,
	|	М.Порядок КАК Порядок
	|ИЗ
	|	РегистрСведений.SmartSale_Маршруты КАК М
	|ГДЕ
	|	М.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|	И М.Пользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	УИДАгента,
	|	ДеньНедели,
	|	Порядок";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("agent_uid", Строка(Выборка.УИДАгента));
		Элемент.Вставить("weekday", Формат(Выборка.ДеньНедели, "ЧГ=0; ЧН=0"));
		Элемент.Вставить("customer_uid", Строка(Выборка.УИДКлиента));
		Элемент.Вставить("sort_order", Формат(Выборка.Порядок, "ЧГ=0; ЧН=0"));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Задания агентов: активные невыполненные. Задание — типовой документ
// «ЗаданиеТорговомуПредставителю» в статусе «К отработке»; агент видит его у
// клиента и отмечает выполнение (POST /tasks → статус «Отработано»). Одно
// задание = один документ: берём первую строку ТЧ Задачи как текст (АРМ
// постановки создаёт по одной задаче на документ).
Функция ЗаданияАгентов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Задачи.Ссылка) КАК УИД,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Задачи.Ссылка.ТорговыйПредставитель) КАК УИДАгента,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Задачи.Ссылка.Партнер) КАК УИДКлиента,
	|	Задачи.Ссылка.ДатаВизитаПлан КАК ДатаЗадания,
	|	Задачи.ОписаниеЗадачи КАК ТекстЗадания
	|ИЗ
	|	Документ.ЗаданиеТорговомуПредставителю.Задачи КАК Задачи
	|ГДЕ
	|	НЕ Задачи.Ссылка.ПометкаУдаления
	|	И Задачи.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаданийТорговымПредставителям.КОтработке)
	|	И Задачи.НомерСтроки = 1
	|	И Задачи.Ссылка.ТорговыйПредставитель <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
	|	И Задачи.Ссылка.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	УИДАгента,
	|	ДатаЗадания";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("agent_uid", Строка(Выборка.УИДАгента));
		Элемент.Вставить("customer_uid", Строка(Выборка.УИДКлиента));
		Элемент.Вставить("date", ДатойИлиПусто(Выборка.ДатаЗадания));
		Элемент.Вставить("text", СокрЛП(Выборка.ТекстЗадания));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Активные вопросы аудита точки для приложения (строит из них форму осмотра).
// Тип ответа отдаём строковым кодом: string/number/bool — по нему телефон
// выбирает вид поля.
Функция ВопросыАудита()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрВопросы.Ссылка) КАК УИД,
	|	СпрВопросы.Наименование КАК Наименование,
	|	СпрВопросы.Текст КАК Текст,
	|	СпрВопросы.ТипОтвета КАК ТипОтвета,
	|	СпрВопросы.Порядок КАК Порядок,
	|	СпрВопросы.Обязательный КАК Обязательный
	|ИЗ
	|	Справочник.SmartSale_ВопросыАудита КАК СпрВопросы
	|ГДЕ
	|	СпрВопросы.Активен
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Наименование";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Текст = СокрЛП(Выборка.Текст);
		Если ПустаяСтрока(Текст) Тогда
			Текст = Выборка.Наименование;
		КонецЕсли;
		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("text", Текст);
		Элемент.Вставить("answer_type", КодТипаОтветаАудита(Выборка.ТипОтвета));
		Элемент.Вставить("order", Выборка.Порядок);
		Элемент.Вставить("required", Выборка.Обязательный);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строковый код типа ответа для телефона. Неизвестный/пустой → string
// (свободный текст — безопасный дефолт, поле всегда заполнимо).
Функция КодТипаОтветаАудита(Знач ТипОтвета)

	Если ТипОтвета = Перечисления.SmartSale_ТипыОтветовАудита.Число Тогда
		Возврат "number";
	ИначеЕсли ТипОтвета = Перечисления.SmartSale_ТипыОтветовАудита.Булево Тогда
		Возврат "bool";
	Иначе
		Возврат "string";
	КонецЕсли;

КонецФункции

// Номенклатура и группы одной выборкой: приложению нужно построить дерево,
// а для этого группы должны приехать вместе с элементами.
Функция Номенклатура(Знач НастройкиСтраницы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Курсор", НастройкиСтраницы.Курсор);

	// «ПЕРВЫЕ» принимает только константу: параметром это число задать
	// нельзя, платформа отвечает «Ожидается константа». Поэтому предел
	// подставляется в текст маркером, а не через УстановитьПараметр.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ %Предел%
	|	СпрНоменклатура.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрНоменклатура.Ссылка) КАК УИД,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрНоменклатура.Родитель) КАК УИДРодителя,
	|	СпрНоменклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	ЕСТЬNULL(СпрНоменклатура.Код, """") КАК Код,
	|	СпрНоменклатура.Наименование КАК Наименование,
	|	ЕСТЬNULL(СпрНоменклатура.НаименованиеПолное, """") КАК НаименованиеПолное,
	|	ЕСТЬNULL(СпрНоменклатура.Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(СпрНоменклатура.ЕдиницаИзмерения.Наименование, """") КАК Единица,
	|	ЕСТЬNULL(СпрНоменклатура.СтавкаНДС.Наименование, """") КАК СтавкаНДС,
	|	НЕ СпрНоменклатура.ПометкаУдаления КАК Активна
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|ГДЕ
	|	СпрНоменклатура.Ссылка > &Курсор
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";

	Запрос.Текст = ПодставитьПредел(Запрос.Текст, НастройкиСтраницы.Предел);

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("is_group", Выборка.ЭтоГруппа);
		Элемент.Вставить("parent_uid", УИДИлиПусто(Выборка.УИДРодителя));
		Элемент.Вставить("code", СокрЛП(Выборка.Код));
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("full_name", СокрЛП(Выборка.НаименованиеПолное));
		Элемент.Вставить("article", СокрЛП(Выборка.Артикул));
		Элемент.Вставить("unit", СокрЛП(Выборка.Единица));
		Элемент.Вставить("vat_rate", СокрЛП(Выборка.СтавкаНДС));
		Элемент.Вставить("active", Выборка.Активна);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Цены на дату.
//
// Источник — регистр ЦеныНоменклатуры25: в этой базе работает
// ценообразование версии 2.5, а старый регистр ЦеныНоменклатуры пуст —
// запрос к нему молча вернул бы ноль строк.
//
// Выборка свёрнута до пары «товар — вид цены». У регистра есть ещё три
// измерения: характеристика, серия и упаковка ценообразования. Сейчас они
// не заполнены, но если цены начнут задавать за упаковку, на одну пару
// придётся несколько строк, и принимающая сторона, разложив ответ в
// словарь, взяла бы произвольную. МАКСИМУМ делает выбор явным.
//
// Упаковка в ответ не передаётся: приложение оперирует единицей хранения.
// Когда цены появятся за коробку, поле придётся добавить — иначе цена за
// коробку будет принята как цена за штуку.
Функция Цены(Знач НаДату)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", НаДату);

	// Отбор видов цен повторён соединением, а не вынесен во вложенный
	// запрос: «РАЗРЕШЕННЫЕ» допускается только у первого запроса пакета,
	// и во вложенном платформа его отвергает.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЦеныСрез.Номенклатура) КАК УИДТовара,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЦеныСрез.ВидЦены) КАК УИДВидаЦены,
	|	МАКСИМУМ(ЦеныСрез.Цена) КАК Цена,
	|	МАКСИМУМ(ЕСТЬNULL(ЦеныСрез.Валюта.Наименование, """")) КАК Валюта
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры25.СрезПоследних(&НаДату, ) КАК ЦеныСрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЦен КАК СпрВидыЦен
	|		ПО ЦеныСрез.ВидЦены = СпрВидыЦен.Ссылка
	|			И СпрВидыЦен.ИспользоватьПриПродаже
	|			И НЕ СпрВидыЦен.ПометкаУдаления
	|			И СпрВидыЦен.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДействияВидовЦен.Действует)
	|ГДЕ
	|	ЦеныСрез.Цена > 0
	|СГРУППИРОВАТЬ ПО
	|	ЦеныСрез.Номенклатура,
	|	ЦеныСрез.ВидЦены
	|УПОРЯДОЧИТЬ ПО
	|	УИДТовара";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("product_uid", Строка(Выборка.УИДТовара));
		Элемент.Вставить("price_type_uid", Строка(Выборка.УИДВидаЦены));
		Элемент.Вставить("price", Деньгами(Выборка.Цена));
		Элемент.Вставить("currency", СокрЛП(Выборка.Валюта));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Свободный остаток: в наличии за вычетом зарезервированного к отгрузке.
// Агенту нужно знать, что он может продать прямо сейчас, а не сколько
// физически лежит на складе.
//
// Свёртка обязательна: у регистра шесть измерений, включая назначение,
// помещение и серию. Сейчас на пару «товар — склад» приходится ровно одна
// строка, но обособленный учёт под заказ заполняет назначение сам, и без
// СУММА принимающая сторона увидела бы остаток одной произвольной строки
// вместо общего.
//
// Склад отбора приходит из СкладТекущегоПользователя: агент видит остатки
// только своего склада. Пустая ссылка означает «без ограничения» — так
// работает привилегированная учётная запись обмена (полная выгрузка).
// Отбор задаётся параметром виртуальной таблицы, а не условием ГДЕ:
// иначе движок сперва посчитал бы остатки по всем складам и лишь потом
// отфильтровал.
Функция Остатки(Знач СкладОтбора)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад", СкладОтбора);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ОстаткиТоваров.Номенклатура) КАК УИДТовара,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ОстаткиТоваров.Склад) КАК УИДСклада,
	|	СУММА(ЕСТЬNULL(ОстаткиТоваров.ВНаличииОстаток, 0)) КАК ВНаличии,
	|	СУММА(ЕСТЬNULL(ОстаткиТоваров.ВНаличииОстаток, 0)
	|		- ЕСТЬNULL(ОстаткиТоваров.КОтгрузкеОстаток, 0)) КАК Свободно
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|		,
	|		&Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
	|			ИЛИ Склад = &Склад) КАК ОстаткиТоваров
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиТоваров.Номенклатура,
	|	ОстаткиТоваров.Склад
	|УПОРЯДОЧИТЬ ПО
	|	УИДТовара";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("product_uid", Строка(Выборка.УИДТовара));
		Элемент.Вставить("warehouse_uid", Строка(Выборка.УИДСклада));
		Элемент.Вставить("on_hand", Количеством(Выборка.ВНаличии));
		Элемент.Вставить("free", Количеством(Выборка.Свободно));
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Клиенты: партнёр как торговая точка плюс реквизиты его контрагента.
//
// Контрагент, контакты и координаты добираются отдельными запросами и
// раскладываются по клиентам в коде. Соединять их с партнёром в одном
// запросе нельзя: у партнёра бывает несколько контрагентов, несколько
// адресов и телефонов, и соединение размножило бы строки клиентов —
// а вместе с ними съело бы предел страницы и сбило курсор.
Функция Клиенты(Знач НастройкиСтраницы)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Курсор", НастройкиСтраницы.Курсор);

	// См. пояснение в функции Номенклатура: предел подставляется в текст.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ %Предел%
	|	СпрПартнеры.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрПартнеры.Ссылка) КАК УИД,
	|	ЕСТЬNULL(СпрПартнеры.Код, """") КАК Код,
	|	СпрПартнеры.Наименование КАК Наименование,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрПартнеры.ОсновнойМенеджер) КАК УИДМенеджера,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрПартнеры.ВидЦен) КАК УИДВидаЦены,
	|	ЕСТЬNULL(СпрПартнеры.БизнесРегион.Наименование, """") КАК БизнесРегион,
	|	ВЫБОР
	|		КОГДА СпрПартнеры.Ссылка В (
	|			ВЫБРАТЬ РАЗЛИЧНЫЕ Дог.Партнер
	|			ИЗ Справочник.ДоговорыКонтрагентов КАК Дог
	|			ГДЕ Дог.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	|				И НЕ Дог.ПометкаУдаления)
	|		ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьДоговор,
	|	НЕ СпрПартнеры.ПометкаУдаления КАК Активен
	|ИЗ
	|	Справочник.Партнеры КАК СпрПартнеры
	|ГДЕ
	|	СпрПартнеры.Клиент
	|	И СпрПартнеры.Ссылка > &Курсор
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";

	Запрос.Текст = ПодставитьПредел(Запрос.Текст, НастройкиСтраницы.Предел);

	Результат = Новый Массив;
	ПоПартнеру = Новый Соответствие;
	СсылкиПартнеров = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("code", СокрЛП(Выборка.Код));
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("legal_name", "");
		Элемент.Вставить("inn", "");
		Элемент.Вставить("manager_uid", УИДИлиПусто(Выборка.УИДМенеджера));
		Элемент.Вставить("price_type_uid", УИДИлиПусто(Выборка.УИДВидаЦены));
		Элемент.Вставить("region", СокрЛП(Выборка.БизнесРегион));
		Элемент.Вставить("counterparty_uid", "");
		Элемент.Вставить("external_code", "");
		Элемент.Вставить("address", "");
		Элемент.Вставить("phone", "");
		Элемент.Вставить("lat", "");
		Элемент.Вставить("lon", "");
		Элемент.Вставить("has_contract", Выборка.ЕстьДоговор);
		// Кредитный контроль — значения по умолчанию; заполняются в
		// ДополнитьКредитом (клиенты без долга/договора остаются с нулями).
		Элемент.Вставить("debt", "0");
		Элемент.Вставить("overdue_debt", "0");
		Элемент.Вставить("overdue_days", "0");
		Элемент.Вставить("credit_limit", "0");
		Элемент.Вставить("limit_enabled", Ложь);
		Элемент.Вставить("forbid_overdue", Ложь);
		Элемент.Вставить("deferral_days", "0");
		Элемент.Вставить("active", Выборка.Активен);

		Результат.Добавить(Элемент);
		ПоПартнеру.Вставить(Выборка.Ссылка, Элемент);
		СсылкиПартнеров.Добавить(Выборка.Ссылка);

	КонецЦикла;

	Если СсылкиПартнеров.Количество() > 0 Тогда
		ПоКонтрагенту = Контрагенты(ПоПартнеру, СсылкиПартнеров);
		ДополнитьКонтактами(ПоПартнеру, СсылкиПартнеров);
		ДополнитьВнешнимКодом(ПоПартнеру, СсылкиПартнеров);
		ДополнитьКоординатами(ПоКонтрагенту);
		ДополнитьКредитом(ПоПартнеру, СсылкиПартнеров);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Контрагент партнёра: юридическое наименование, ИНН и ссылка для поиска
// координат.
//
// Берётся ОДИН контрагент на партнёра, с приоритетом головного. Отсечь
// обособленные подразделения прямо в отборе нельзя: в базе 91 клиент, у
// которого контрагент существует, но помечен обособленным подразделением.
// С таким условием они остались бы вовсе без реквизитов и без координат —
// и совершенно молча.
//
// Возвращаемое значение:
//  Соответствие - ссылка контрагента -> структура клиента, для координат.
Функция Контрагенты(ПоПартнеру, Знач Ссылки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СпрКонтрагенты.Партнер КАК Партнер,
	|	СпрКонтрагенты.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрКонтрагенты.Ссылка) КАК УИД,
	|	ЕСТЬNULL(СпрКонтрагенты.НаименованиеПолное, """") КАК ЮрНаименование,
	|	ЕСТЬNULL(СпрКонтрагенты.ИНН, """") КАК ИНН,
	|	ВЫБОР
	|		КОГДА СпрКонтрагенты.ОбособленноеПодразделение
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.Контрагенты КАК СпрКонтрагенты
	|ГДЕ
	|	СпрКонтрагенты.Партнер В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Ссылка";

	ПоКонтрагенту = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Элемент = ПоПартнеру[Выборка.Партнер];

		// Выборка упорядочена по приоритету, поэтому первым приходит
		// головной. Заполненное не перезаписывается — иначе подразделение
		// затёрло бы реквизиты головного.
		Если Элемент = Неопределено Или Не ПустаяСтрока(Элемент.counterparty_uid) Тогда
			Продолжить;
		КонецЕсли;

		Элемент.counterparty_uid = Строка(Выборка.УИД);
		Элемент.legal_name = СокрЛП(Выборка.ЮрНаименование);
		Элемент.inn = СокрЛП(Выборка.ИНН);

		ПоКонтрагенту.Вставить(Выборка.Ссылка, Элемент);

	КонецЦикла;

	Возврат ПоКонтрагенту;

КонецФункции

// Адрес и телефон партнёра. Берётся первое непустое значение каждого вида:
// у точки может быть записано несколько телефонов, агенту нужен основной.
Процедура ДополнитьКонтактами(ПоПартнеру, Знач Ссылки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КИ.Ссылка КАК Владелец,
	|	КИ.Вид.Тип КАК ТипКИ,
	|	КИ.Представление КАК Представление
	|ИЗ
	|	Справочник.Партнеры.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Ссылка В (&Ссылки)
	|	И КИ.Представление <> """"
	|УПОРЯДОЧИТЬ ПО
	|	КИ.НомерСтроки";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Элемент = ПоПартнеру[Выборка.Владелец];
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Выборка.ТипКИ = Перечисления.ТипыКонтактнойИнформации.Адрес
			И ПустаяСтрока(Элемент.address) Тогда
			Элемент.address = СокрЛП(Выборка.Представление);
		ИначеЕсли Выборка.ТипКИ = Перечисления.ТипыКонтактнойИнформации.Телефон
			И ПустаяСтрока(Элемент.phone) Тогда
			Элемент.phone = СокрЛП(Выборка.Представление);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Код внешней системы — дополнительный реквизит партнёра, заполненный при
// загрузке клиентов. Это код точки в прежней системе учёта, и по нему
// сверяются данные при разборе расхождений.
Процедура ДополнитьВнешнимКодом(ПоПартнеру, Знач Ссылки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.УстановитьПараметр("Имя", "КодВнешнейСистемы");
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДопРеквизиты.Ссылка КАК Владелец,
	|	ДопРеквизиты.Значение КАК Значение
	|ИЗ
	|	Справочник.Партнеры.ДополнительныеРеквизиты КАК ДопРеквизиты
	|ГДЕ
	|	ДопРеквизиты.Ссылка В (&Ссылки)
	|	И ДопРеквизиты.Свойство.ИдентификаторДляФормул = &Имя";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = ПоПартнеру[Выборка.Владелец];
		Если Элемент <> Неопределено Тогда
			Элемент.external_code = СокрЛП(Строка(Выборка.Значение));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Кредитный контроль: долг клиента, просроченная часть и лимит из
// действующего договора. Долг — остаток регистра
// РасчетыСКлиентамиПоСрокам (он ведёт долг по срокам погашения);
// просрочено — часть, срок погашения которой уже наступил. Лимит, запрет
// просрочки и срок оплаты — из ДЕЙСТВУЮЩЕГО договора (выбор тот же, что у
// has_contract: последний действующий по дате). База одновалютная —
// берём валюту управленческого учёта. Клиенты без долга/договора остаются
// с нулями, проставленными в основном цикле.
Процедура ДополнитьКредитом(ПоПартнеру, Знач Ссылки)

	ЗаполнитьЛимитыДоговоров(ПоПартнеру, Ссылки);
	ЗаполнитьДолгКлиентов(ПоПартнеру, Ссылки);

КонецПроцедуры

// Лимит долга, запрет просрочки и срок оплаты из действующего договора.
// Выборка упорядочена по партнёру, дате и ссылке убыв — первым приходит
// последний договор, его и берём (остальные договоры партнёра пропускаем).
// Допущение: у клиента один действующий договор (в базе договоры единичны).
// Если у партнёра действующие договоры в РАЗНЫХ организациях — берётся просто
// самый свежий, лимит может прийти от другой организации. Долг мы и так
// агрегируем по клиенту (все организации), а один клиент обслуживается одним
// агентом с одной организацией — для Фазы 1 приемлемо; при появлении
// мультиорганизационных клиентов фильтровать по организации отгрузки.
Процедура ЗаполнитьЛимитыДоговоров(ПоПартнеру, Знач Ссылки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Дог.Партнер КАК Партнер,
	|	ЕСТЬNULL(Дог.ДопустимаяСуммаЗадолженности, 0) КАК Лимит,
	|	Дог.ОграничиватьСуммуЗадолженности КАК ЛимитВключен,
	|	Дог.ЗапрещаетсяПросроченнаяЗадолженность КАК ЗапретПросрочки,
	|	ВЫБОР
	|		КОГДА Дог.УстановленСрокОплаты
	|			ТОГДА ЕСТЬNULL(Дог.СрокОплаты, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СрокОплаты
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Дог
	|ГДЕ
	|	Дог.Партнер В (&Ссылки)
	|	И Дог.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	|	И НЕ Дог.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Дог.Партнер,
	|	Дог.Дата УБЫВ,
	|	Дог.Ссылка УБЫВ";

	Заполнены = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Элемент = ПоПартнеру[Выборка.Партнер];
		Если Элемент = Неопределено Или Заполнены[Выборка.Партнер] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Элемент.credit_limit  = Деньгами(Выборка.Лимит);
		Элемент.limit_enabled = Выборка.ЛимитВключен;
		Элемент.forbid_overdue = Выборка.ЗапретПросрочки;
		Элемент.deferral_days = Формат(Выборка.СрокОплаты, "ЧГ=0; ЧН=0");

		Заполнены.Вставить(Выборка.Партнер, Истина);

	КонецЦикла;

КонецПроцедуры

// Текущий долг клиента и просроченная его часть из
// РасчетыСКлиентамиПоСрокам. Группируем по партнёру (у клиента бывает
// несколько договоров/объектов расчётов — долг общий). Дни просрочки —
// от старейшего наступившего срока погашения до сегодня.
Процедура ЗаполнитьДолгКлиентов(ПоПартнеру, Знач Ссылки)

	Сегодня = НачалоДня(ТекущаяДатаСеанса());

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.УстановитьПараметр("Валюта", Константы.ВалютаУправленческогоУчета.Получить());
	Запрос.УстановитьПараметр("Сегодня", Сегодня);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ост.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
	|	СУММА(Ост.ДолгОстаток) КАК Долг,
	|	СУММА(ВЫБОР
	|			КОГДА Ост.ДатаПлановогоПогашения > ДАТАВРЕМЯ(1, 1, 1)
	|					И Ост.ДатаПлановогоПогашения < &Сегодня
	|				ТОГДА Ост.ДолгОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Просрочено,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА Ост.ДатаПлановогоПогашения > ДАТАВРЕМЯ(1, 1, 1)
	|					И Ост.ДатаПлановогоПогашения < &Сегодня И Ост.ДолгОстаток > 0
	|				ТОГДА Ост.ДатаПлановогоПогашения
	|			ИНАЧЕ ДАТАВРЕМЯ(3999, 1, 1)
	|		КОНЕЦ) КАК СтарейшийСрок
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.Остатки(
	|			,
	|			АналитикаУчетаПоПартнерам.Партнер В (&Ссылки) И Валюта = &Валюта) КАК Ост
	|СГРУППИРОВАТЬ ПО
	|	Ост.АналитикаУчетаПоПартнерам.Партнер";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Элемент = ПоПартнеру[Выборка.Партнер];
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Элемент.debt         = Деньгами(Выборка.Долг);
		Элемент.overdue_debt = Деньгами(Выборка.Просрочено);

		ДнейПросрочки = 0;
		Если Выборка.Просрочено > 0 И Выборка.СтарейшийСрок < Дата(3999, 1, 1) Тогда
			// НачалоДня — на случай, если у срока погашения есть время суток:
			// иначе Цел() округлил бы неполные сутки в 0 и просрочку в 1 день
			// потеряли бы.
			ДнейПросрочки = Цел((Сегодня - НачалоДня(Выборка.СтарейшийСрок)) / 86400);
		КонецЕсли;
		Элемент.overdue_days = Формат(ДнейПросрочки, "ЧГ=0; ЧН=0");

	КонецЦикла;

КонецПроцедуры

// Координаты точки лежат у контрагента, а не у партнёра: виды контактной
// информации для широты и долготы заведены именно там.
Процедура ДополнитьКоординатами(ПоКонтрагенту)

	Если ПоКонтрагенту.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Ссылки = Новый Массив;
	Для Каждого Пара Из ПоКонтрагенту Цикл
		Ссылки.Добавить(Пара.Ключ);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.УстановитьПараметр("Широта", "ГеографическаяШирота");
	Запрос.УстановитьПараметр("Долгота", "ГеографическаяДолгота");
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КИ.Ссылка КАК Владелец,
	|	КИ.Вид.ИдентификаторДляФормул КАК Идентификатор,
	|	КИ.Представление КАК Представление
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Ссылка В (&Ссылки)
	|	И КИ.Вид.ИдентификаторДляФормул В (&Широта, &Долгота)
	|	И КИ.Представление <> """"";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Элемент = ПоКонтрагенту[Выборка.Владелец];
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Координата = КоординатойСтрокой(Выборка.Представление);
		Если ПустаяСтрока(Координата) Тогда
			Продолжить;
		КонецЕсли;

		Если Выборка.Идентификатор = "ГеографическаяШирота" Тогда
			Элемент.lat = Координата;
		Иначе
			Элемент.lon = Координата;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Акции: активные, действующие на текущую дату. Шапки, товары и пороги —
// тремя запросами и сборка в коде: у акции две табличные части, соединение
// в одном запросе размножило бы строки. Даты состава «Дата» (без времени):
// пустая = ДАТАВРЕМЯ(1,1,1); границы сравниваем с началом и концом текущего
// дня, иначе акция, кончающаяся сегодня, отсеклась бы по времени.
Функция Акции()

	Сейчас = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Сейчас));
	Запрос.УстановитьПараметр("КонецДня", КонецДня(Сейчас));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Акц.Ссылка КАК Ссылка,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Акц.Ссылка) КАК УИД,
	|	Акц.Наименование КАК Наименование,
	|	ВЫБОР
	|		КОГДА Акц.ВидМеханики = ЗНАЧЕНИЕ(Перечисление.SmartSale_ВидыМеханикиАкций.Процент) ТОГДА ""percent""
	|		КОГДА Акц.ВидМеханики = ЗНАЧЕНИЕ(Перечисление.SmartSale_ВидыМеханикиАкций.Объем) ТОГДА ""volume""
	|		КОГДА Акц.ВидМеханики = ЗНАЧЕНИЕ(Перечисление.SmartSale_ВидыМеханикиАкций.Бонус) ТОГДА ""bonus""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Механика,
	|	Акц.ДатаНачала КАК ДатаНачала,
	|	Акц.ДатаОкончания КАК ДатаОкончания,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Акц.Сегмент) КАК УИДСегмента,
	|	Акц.Приоритет КАК Приоритет,
	|	Акц.Процент КАК Процент,
	|	Акц.КупитьКоличество КАК КупитьКоличество,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Акц.БонусныйТовар) КАК УИДБонусногоТовара,
	|	Акц.БонусноеКоличество КАК БонусноеКоличество
	|ИЗ
	|	Справочник.SmartSale_Акции КАК Акц
	|ГДЕ
	|	Акц.Активна
	|	И НЕ Акц.ПометкаУдаления
	|	И (Акц.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Акц.ДатаНачала <= &КонецДня)
	|	И (Акц.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) ИЛИ Акц.ДатаОкончания >= &НачалоДня)
	|УПОРЯДОЧИТЬ ПО
	|	Акц.Приоритет УБЫВ,
	|	Ссылка";

	Результат = Новый Массив;
	ПоАкции = Новый Соответствие;
	СсылкиАкций = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("mechanic", Выборка.Механика);
		Элемент.Вставить("date_from", ДатойИлиПусто(Выборка.ДатаНачала));
		Элемент.Вставить("date_to", ДатойИлиПусто(Выборка.ДатаОкончания));
		Элемент.Вставить("segment_uid", УИДИлиПусто(Выборка.УИДСегмента));
		Элемент.Вставить("priority", Формат(Выборка.Приоритет, "ЧГ=0; ЧН=0"));
		Элемент.Вставить("percent", Деньгами(Выборка.Процент));
		Элемент.Вставить("buy_qty", Количеством(Выборка.КупитьКоличество));
		Элемент.Вставить("bonus_product_uid", УИДИлиПусто(Выборка.УИДБонусногоТовара));
		Элемент.Вставить("bonus_qty", Количеством(Выборка.БонусноеКоличество));
		Элемент.Вставить("products", Новый Массив);
		Элемент.Вставить("thresholds", Новый Массив);
		Результат.Добавить(Элемент);
		ПоАкции.Вставить(Выборка.Ссылка, Элемент);
		СсылкиАкций.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Если СсылкиАкций.Количество() > 0 Тогда
		ДополнитьТоварамиАкций(ПоАкции, СсылкиАкций);
		ДополнитьПорогамиАкций(ПоАкции, СсылкиАкций);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Товары акции. Группа номенклатуры допускается: приложение раскрывает её по
// своему каталогу, поэтому передаём и признак группы.
Процедура ДополнитьТоварамиАкций(ПоАкции, Знач Ссылки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Тов.Ссылка КАК Акция,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Тов.Номенклатура) КАК УИДТовара,
	|	ЕСТЬNULL(Тов.Номенклатура.ЭтоГруппа, ЛОЖЬ) КАК ЭтоГруппа
	|ИЗ
	|	Справочник.SmartSale_Акции.Товары КАК Тов
	|ГДЕ
	|	Тов.Ссылка В (&Ссылки)
	|	И Тов.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = ПоАкции[Выборка.Акция];
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТовара = Новый Структура;
		СтрокаТовара.Вставить("uid", Строка(Выборка.УИДТовара));
		СтрокаТовара.Вставить("is_group", Выборка.ЭтоГруппа);
		Элемент.products.Добавить(СтрокаТовара);
	КонецЦикла;

КонецПроцедуры

// Пороги объёмной акции. Число порогов невелико, курсор не нужен.
Процедура ДополнитьПорогамиАкций(ПоАкции, Знач Ссылки)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Пор.Ссылка КАК Акция,
	|	Пор.МинКоличество КАК МинКоличество,
	|	Пор.МинСумма КАК МинСумма,
	|	Пор.Процент КАК Процент
	|ИЗ
	|	Справочник.SmartSale_Акции.Пороги КАК Пор
	|ГДЕ
	|	Пор.Ссылка В (&Ссылки)
	|УПОРЯДОЧИТЬ ПО
	|	Пор.МинКоличество,
	|	Пор.МинСумма";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = ПоАкции[Выборка.Акция];
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокаПорога = Новый Структура;
		СтрокаПорога.Вставить("min_qty", Количеством(Выборка.МинКоличество));
		СтрокаПорога.Вставить("min_sum", Деньгами(Выборка.МинСумма));
		СтрокаПорога.Вставить("percent", Деньгами(Выборка.Процент));
		Элемент.thresholds.Добавить(СтрокаПорога);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СкладАгента

// Ссылка пользователя-агента по идентификатору из запроса.
//
// К сервису обращается доверенный сервер SmartSale под одним сервисным
// токеном и сам подставляет, за какого агента тянет данные, — поэтому
// агент приходит параметром, а не берётся из сеанса. Пустой идентификатор
// допустим: означает сервисный режим без привязки к агенту.
Функция АгентИзЗапроса(Знач ВходящийЗапрос)

	Значение = СокрЛП(ПараметрЗапроса(ВходящийЗапрос, "agent"));

	Если ПустаяСтрока(Значение) Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Значение);
	Исключение
		ВызватьИсключение "Параметр «agent» не является идентификатором.";
	КонецПопытки;

	Ссылка = Справочники.Пользователи.ПолучитьСсылку(Идентификатор);

	Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		ВызватьИсключение "Параметр «agent» указывает на несуществующего пользователя.";
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Организация, склад и подразделение агента, а также склад отбора остатков
// живут в общем модуле SmartSale_Обмен: они нужны и здесь (остатки), и при
// приёме заказов, а дублировать выборку в двух модулях — заводить источник
// расхождений.

#КонецОбласти

#Область Авторизация

// Проверка токена. Возвращает Неопределено при успехе либо готовый ответ
// 401, который обработчик сразу отдаёт клиенту.
//
// К сервису обращается доверенный сервер SmartSale под одним сервисным
// токеном. Токен приходит заголовком «X-SmartSale-Token» (поверх Basic 1С).
// В базе хранится не сам токен, а его SHA-256: утечка регистра не даёт
// действующего токена, как и с паролями. Отозвать токен — снять флаг
// «Активен» или удалить запись.
//
// Публикация настраивается так, чтобы веб-сервер НЕ требовал свою
// аутентификацию (Basic отключён, в vrd прописана служебная учётная
// запись): единственный рубеж — этот токен. Иначе клиенту пришлось бы
// одновременно и проходить Basic, и слать токен.
Функция ПроверитьТокен(Знач ВходящийЗапрос)

	Попытка
		Токен = ТокенИзЗаголовка(ВходящийЗапрос);
	Исключение
		Возврат ОтветНеавторизован("Не разобран заголовок токена.");
	КонецПопытки;

	Если ПустаяСтрока(Токен) Тогда
		Возврат ОтветНеавторизован("Отсутствует токен. Ожидается заголовок «X-SmartSale-Token».");
	КонецЕсли;

	Хеш = ХешТокена(Токен);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Хеш", Хеш);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Найдено
	|ИЗ
	|	РегистрСведений.SmartSale_Токены КАК Токены
	|ГДЕ
	|	Токены.Хеш = &Хеш
	|	И Токены.Активен";

	Если Запрос.Выполнить().Пустой() Тогда
		Возврат ОтветНеавторизован("Токен недействителен или отозван.");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Токен из заголовка «X-SmartSale-Token».
//
// Отдельный заголовок, а НЕ «Authorization: Bearer»: публикация 1С занимает
// «Authorization» под Basic-аутентификацию (веб-сервер спрашивает учётную
// запись 1С до того, как запрос дойдёт до модуля), а двух значений в одном
// заголовке не бывает. Поэтому токен идёт своим заголовком поверх Basic —
// публикацию не приходится перенастраивать, а рубежей становится два:
// служебная учётка веб-сервера и наш токен.
//
// Имя ищется без учёта регистра: веб-серверы нормализуют регистр по-разному.
Функция ТокенИзЗаголовка(Знач ВходящийЗапрос)

	Для Каждого Заголовок Из ВходящийЗапрос.Заголовки Цикл
		Если ВРег(Заголовок.Ключ) = "X-SMARTSALE-TOKEN" Тогда
			Возврат СокрЛП(Заголовок.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// SHA-256 токена в виде hex-строки в нижнем регистре — так же считает
// скрипт выпуска токенов, иначе сравнение не сойдётся.
Функция ХешТокена(Знач Токен)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Токен, "UTF-8", Ложь));

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

Функция ОтветНеавторизован(Знач Текст)

	Данные = Новый Структура;
	Данные.Вставить("error", Текст);
	Данные.Вставить("server_time", ВремяСервера());

	Возврат ОтветСДанными(Данные, 401);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тело запроса как разобранная структура JSON.
Функция ПрочитатьТелоЗапроса(Знач ВходящийЗапрос)

	Текст = ВходящийЗапрос.ПолучитьТелоКакСтроку("UTF-8");

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		ВызватьИсключение "Пустое тело запроса. Ожидается JSON.";
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);

	Попытка
		Данные = ПрочитатьJSON(Чтение);
	Исключение
		ВызватьИсключение "Тело запроса не является корректным JSON.";
	КонецПопытки;

	Возврат Данные;

КонецФункции

Функция ВерсияПротокола()

	Возврат "1.0";

КонецФункции

// Время сервера в UTC с суффиксом Z. Плюс в строке запроса означает
// пробел, и клиент, забывший его закодировать, получил бы отлуп на ровном
// месте — поэтому смещение не пишется вовсе.
Функция ВремяСервера()

	Возврат Формат(УниверсальноеВремя(ТекущаяДатаСеанса()),
		"ДФ=""гггг-ММ-ддTЧЧ:мм:сс""") + "Z";

КонецФункции

// Страница списка.
//
// Предел передаётся параметром, а не читается из константы второй раз:
// выборка запрашивала «предел плюс один», и если здесь сравнивать с другим
// числом, признак «есть ещё» окажется ложным, а выгрузка молча оборвётся
// на первой странице.
Функция СтраницаСписка(СписокЭлементов, Знач Предел)

	ЕстьЕщё = СписокЭлементов.Количество() > Предел;

	Если ЕстьЕщё Тогда
		// Лишний элемент запрашивался только ради ответа на вопрос
		// «есть ли ещё», в выдачу он не идёт.
		СписокЭлементов.Удалить(СписокЭлементов.ВГраница());
	КонецЕсли;

	Курсор = "";
	Если ЕстьЕщё И СписокЭлементов.Количество() > 0 Тогда
		Курсор = СписокЭлементов[СписокЭлементов.ВГраница()].uid;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("protocol", ВерсияПротокола());
	Данные.Вставить("server_time", ВремяСервера());
	Данные.Вставить("count", СписокЭлементов.Количество());
	Данные.Вставить("more", ЕстьЕщё);
	Данные.Вставить("next", Курсор);
	Данные.Вставить("items", СписокЭлементов);

	Возврат ОтветСДанными(Данные);

КонецФункции

// Список целиком, без нарезки на страницы.
//
// Так отдаются цены и остатки: они привязаны к паре объектов, а не к
// одному, и курсор по ним не построить. Объём ограничен числом позиций
// номенклатуры, поэтому ответ остаётся обозримым. Поля `more` и `next`
// присутствуют ради единообразия разбора и всегда пусты.
Функция ПолныйСписок(Знач СписокЭлементов)

	Данные = Новый Структура;
	Данные.Вставить("protocol", ВерсияПротокола());
	Данные.Вставить("server_time", ВремяСервера());
	Данные.Вставить("count", СписокЭлементов.Количество());
	Данные.Вставить("more", Ложь);
	Данные.Вставить("next", "");
	Данные.Вставить("items", СписокЭлементов);

	Возврат ОтветСДанными(Данные);

КонецФункции

// Размер страницы.
//
// Верхний предел ограничен не только объёмом ответа: ссылки отобранных
// партнёров передаются в дозапросы параметром «В (&Ссылки)», а число
// значений в таком списке у СУБД конечно. Тысяча — заведомо безопасно.
Функция ПределСтраницы()

	Возврат 1000;

КонецФункции

// Подстановка предела в текст запроса.
//
// Берётся на единицу больше запрошенного: лишняя запись нужна только для
// ответа на вопрос «есть ли ещё страница», в выдачу она не попадает.
// Число формируется Форматом без разделителя групп — пробел в тексте
// запроса сделал бы его синтаксически неверным.
Функция ПодставитьПредел(Знач ТекстЗапроса, Знач Предел)

	Возврат СтрЗаменить(ТекстЗапроса, "%Предел%",
		Формат(Предел + 1, "ЧГ=0; ЧН=0"));

КонецФункции

// Курсор и предел из строки запроса.
//
// Курсор приходит идентификатором, а сравнение в запросе идёт по ссылке,
// поэтому он превращается обратно в ссылку. Менеджер справочника
// передаётся параметром — у каждой выборки своя таблица, и пустая ссылка
// «начала обхода» тоже должна быть её типа.
//
// Существование объекта проверяется намеренно: ПолучитьСсылку принимает
// любой идентификатор, в том числе чужого справочника. Подстановка такого
// значения не вызвала бы ошибки — выгрузка просто началась бы с середины,
// и часть данных пропала бы при внешне благополучном ответе.
Функция ПараметрыСтраницы(Знач ВходящийЗапрос, Знач МенеджерСправочника)

	Настройки = Новый Структура;
	Настройки.Вставить("Курсор", МенеджерСправочника.ПустаяСсылка());
	Настройки.Вставить("Предел", ПределСтраницы());

	Значение = СокрЛП(ПараметрЗапроса(ВходящийЗапрос, "after"));

	Если Не ПустаяСтрока(Значение) Тогда

		Попытка
			Идентификатор = Новый УникальныйИдентификатор(Значение);
		Исключение
			ВызватьИсключение "Параметр «after» не является идентификатором.";
		КонецПопытки;

		Ссылка = МенеджерСправочника.ПолучитьСсылку(Идентификатор);

		Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			ВызватьИсключение "Параметр «after» указывает на несуществующий объект.";
		КонецЕсли;

		Настройки.Курсор = Ссылка;

	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Дата среза цен.
//
// Принимается и «ГГГГ-ММ-ДД», и полная отметка вида «2026-09-16T12:00:00Z»,
// которую сервис отдаёт сам в `server_time`: клиент, подставивший её
// обратно, не должен получать отказ.
//
// Отметка трактуется как UTC и переводится в местное время сеанса —
// регистр цен хранит местное, и без перевода срез брался бы на момент,
// смещённый на часовой пояс.
//
// Дата без времени означает КОНЕЦ суток, а не начало: регистр периодичен
// посекундно, и срез на 00:00 не увидел бы цены, введённые в этот день.
Функция ДатаИзЗапроса(Знач ВходящийЗапрос)

	Значение = СокрЛП(ПараметрЗапроса(ВходящийЗапрос, "date"));

	Если ПустаяСтрока(Значение) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;

	ЭтоОтметкаВремени = СтрНайти(Значение, "T") > 0;

	Очищенное = СтрЗаменить(Значение, "-", "");
	Очищенное = СтрЗаменить(Очищенное, ":", "");
	Очищенное = СтрЗаменить(Очищенное, "T", "");
	Очищенное = СтрЗаменить(Очищенное, "Z", "");
	Очищенное = СокрЛП(Очищенное);

	Попытка
		Разобранная = Дата(Очищенное);
	Исключение
		ВызватьИсключение "Параметр «date» не является датой. Ожидается ГГГГ-ММ-ДД.";
	КонецПопытки;

	Если ЭтоОтметкаВремени Тогда
		Возврат МестноеВремя(Разобранная);
	КонецЕсли;

	Возврат КонецДня(Разобранная);

КонецФункции

Функция ПараметрЗапроса(Знач ВходящийЗапрос, Знач Имя)

	Значение = ВходящийЗапрос.ПараметрыЗапроса.Получить(Имя);

	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

Функция УИДИлиПусто(Знач Идентификатор)

	Текст = Строка(Идентификатор);

	Возврат ?(Текст = "00000000-0000-0000-0000-000000000000", "", Текст);

КонецФункции

// Дата в виде «ГГГГ-ММ-ДД» либо пустая строка. Пустая дата состава «Дата» —
// ДАТАВРЕМЯ(1,1,1), её отдаём пустой строкой, как и прочие пустые значения.
Функция ДатойИлиПусто(Знач Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Значение, "ДФ=гггг-ММ-дд");

КонецФункции

// Деньги строкой: два знака, разделитель — точка, групп нет.
// «ЧН=0» обязателен: без него ноль печатается пустой строкой.
Функция Деньгами(Знач Значение)

	Возврат Формат(Значение, "ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0");

КонецФункции

// Количества — три знака: весовой товар продаётся килограммами с граммами.
Функция Количеством(Знач Значение)

	Возврат Формат(Значение, "ЧДЦ=3; ЧРД=.; ЧГ=0; ЧН=0");

КонецФункции

// Координата строкой, как она хранится: «41.2848554».
//
// В число НЕ преобразуется намеренно. Приведение строки к числу зависит от
// того, чем в текущей локали считается точка — разделителем дробной части
// или разделителем разрядов. Ошибка здесь тихая: координата превращается
// в ноль или в целое из всех цифр, и точка уезжает в Атлантику либо на
// другой конец света, причём без единой записи в журнале.
//
// Проверяется только формат: знак, цифры, не больше одной точки. Значение
// с запятой приводится к точке — принимающая сторона разбирает строку
// сама, в своей локали, где точка однозначна.
Функция КоординатойСтрокой(Знач Текст)

	Очищенное = СтрЗаменить(СокрЛП(Текст), ",", ".");
	Очищенное = СтрЗаменить(Очищенное, " ", "");

	Если ПустаяСтрока(Очищенное) Тогда
		Возврат "";
	КонецЕсли;

	Знак = "";
	Если Лев(Очищенное, 1) = "-" Тогда
		Знак = "-";
		Очищенное = Сред(Очищенное, 2);
	КонецЕсли;

	Части = СтрРазделить(Очищенное, ".", Истина);

	Если Части.Количество() > 2 Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Часть Из Части Цикл
		Если ПустаяСтрока(Часть) Или Не ТолькоЦифры(Часть) Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат Знак + Очищенное;

КонецФункции

Функция ТолькоЦифры(Знач Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ОтветСДанными(Знач Данные, Знач Код = 200)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);

	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8);

	Возврат Ответ;

КонецФункции

// Отказ по вине клиента: неверный параметр. Код 400, а не 500.
//
// Различие существенно для планировщика на той стороне: 5xx он будет
// повторять, считая сбоем связи, и неисправимый запрос уйдёт в бесконечный
// цикл, засыпая журнал регистрации ошибками. Текст здесь наш собственный и
// устройства базы не раскрывает, поэтому отдаётся как есть.
Функция ОтветОтказа(Знач ИнфОшибки, Знач Метод)

	Данные = Новый Структура;
	Данные.Вставить("error", КраткоеПредставлениеОшибки(ИнфОшибки));
	Данные.Вставить("method", Метод);
	Данные.Вставить("server_time", ВремяСервера());

	Возврат ОтветСДанными(Данные, 400);

КонецФункции

// Сбой на стороне сервиса. Код 500.
//
// Наружу уходит только метка записи журнала, без текста ошибки: краткое
// представление ошибки 1С содержит имена таблиц и полей, а этот канал
// смотрит в интернет. Разобрать обращение по метке можно за минуту,
// а отдавать устройство базы незачем.
Функция ОтветОшибки(Знач ИнфОшибки, Знач Метод)

	Метка = Строка(Новый УникальныйИдентификатор());

	Попытка
		ЗаписьЖурналаРегистрации("SmartSale.Обмен",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Метод " + Метод + ", метка " + Метка + ": "
				+ КраткоеПредставлениеОшибки(ИнфОшибки) + Символы.ПС
				+ ПодробноеПредставлениеОшибки(ИнфОшибки));
	Исключение
		// Журнал недоступен — ответить клиенту всё равно нужно.
	КонецПопытки;

	Данные = Новый Структура;
	Данные.Вставить("error", "Внутренняя ошибка сервиса.");
	Данные.Вставить("method", Метод);
	Данные.Вставить("trace_id", Метка);
	Данные.Вставить("server_time", ВремяСервера());

	Возврат ОтветСДанными(Данные, 500);

КонецФункции

#КонецОбласти
