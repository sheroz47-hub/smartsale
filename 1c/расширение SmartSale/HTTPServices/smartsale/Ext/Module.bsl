		Возврат ОтветОшибки(ИнформацияОбОшибке(), "orders/state");
	КонецПопытки;

КонецФункции

// Приём оплат (приходных кассовых ордеров) из SmartSale. Тело — JSON вида
// {"payments": [ ... ]}, каждая оплата:
//   client_uid   — ключ идемпотентности, генерирует телефон
//   customer_uid — идентификатор ссылки партнёра
//   amount       — сумма оплаты (строкой, разделитель — точка)
//   date         — дата приёма оплаты агентом (в комментарий)
//   comment      — комментарий агента
// Организация и касса берутся по агенту из регистра SmartSale_СкладыАгентов.
//
// Оплата садится в счёт ОБЩЕГО долга клиента (без привязки к заказу).
// Пакетность, идемпотентность и dryrun — как у /orders.
Функция paymentsPOST(ВходящийЗапрос) Экспорт

	Отказ = ПроверитьТокен(ВходящийЗапрос);
	Если Отказ <> Неопределено Тогда
		Возврат Отказ;
	КонецЕсли;

	Попытка
		Пакет = ПрочитатьТелоЗапроса(ВходящийЗапрос);
	Исключение
		Возврат ОтветОтказа(ИнформацияОбОшибке(), "payments");
	КонецПопытки;

	Попытка
		ТолькоПроверка = ПараметрЗапроса(ВходящийЗапрос, "dryrun") = "1";
		Агент = АгентИзЗапроса(ВходящийЗапрос);
		Возврат ОтветСДанными(
			SmartSale_Обмен.ПринятьПакетОплат(Пакет, Агент, ТолькоПроверка));
	Исключение
		Возврат ОтветОшибки(ИнформацияОбОшибке(), "payments");
	КонецПопытки;

КонецФункции

