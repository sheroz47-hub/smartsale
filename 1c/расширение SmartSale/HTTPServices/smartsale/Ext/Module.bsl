// точке нужно знать, отгрузили ли прошлый заказ и не отменил ли его офис.
Функция ordersStatePOST(ВходящийЗапрос) Экспорт

	Отказ = ПроверитьТокен(ВходящийЗапрос);
	Если Отказ <> Неопределено Тогда
