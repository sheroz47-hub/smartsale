// Приём заказов из SmartSale. Тело — JSON вида {"orders": [ ... ]}.
//
// Пакетность: каждый заказ обрабатывается и отвечает за себя. Один
// отклонённый не роняет остальные — приложение по ответу решает, что убрать
// из очереди отправки, а что показать агенту и оставить.
//
// Идемпотентность по client_uid: связь на рынке рвётся посреди отправки,
// приложение повторяет запрос, и повторный client_uid возвращает результат
// первого приёма, а не создаёт второй заказ.
//
// Режим проверки: /orders?dryrun=1 заполняет и проводит заказ в транзакции,
// которую затем ОТКАТЫВАЕТ. Боевой документ не создаётся, но видно, прошло
// бы заполнение и проведение. Нужен для отладки на живой базе, потому что
// со стороны 1С запись документов иначе не проверить.
Функция ordersPOST(ВходящийЗапрос) Экспорт

	Отказ = ПроверитьТокен(ВходящийЗапрос);
	Если Отказ <> Неопределено Тогда
		Возврат Отказ;
	КонецЕсли;

	Попытка
		Пакет = ПрочитатьТелоЗапроса(ВходящийЗапрос);
	Исключение
		Возврат ОтветОтказа(ИнформацияОбОшибке(), "orders");
	КонецПопытки;

	Попытка
		ТолькоПроверка = ПараметрЗапроса(ВходящийЗапрос, "dryrun") = "1";
		Агент = АгентИзЗапроса(ВходящийЗапрос);
		Возврат ОтветСДанными(
			SmartSale_Обмен.ПринятьПакетЗаказов(Пакет, Агент, ТолькоПроверка));
	Исключение
		Возврат ОтветОшибки(ИнформацияОбОшибке(), "orders");
	КонецПопытки;

КонецФункции

// Состояние ранее принятых заказов по их client_uid.
