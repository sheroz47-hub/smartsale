// HTTP-сервис обмена с приложением SmartSale. Этап 1: отдача справочников.
//
// НАПРАВЛЕНИЕ. Инициатор обмена — сервер SmartSale: он ходит сюда по
// расписанию и забирает данные. УТ сама наружу не стучится, поэтому здесь
// только чтение — записи документов появятся вторым этапом.
//
// КЛЮЧ СОПОСТАВЛЕНИЯ — уникальный идентификатор ссылки 1С (`uid` в ответах).
// Отдельный регистр соответствия не заводится намеренно: идентификатор
// ссылки не меняется никогда, тогда как код и наименование меняют.
//
// ПОСТРАНИЧНОСТЬ КУРСОРОМ, а не смещением: в языке запросов 1С нет OFFSET.
// Клиент передаёт `after` — идентификатор последней полученной ссылки,
// выборка упорядочена по ссылке и отдаёт то, что строго больше.
//
// Оговорка про устойчивость: порядок обхода — двоичный порядок ссылок, а не
// хронологический. Элемент, созданный во время выгрузки, может оказаться
// «до» курсора и на текущем проходе не попасть в выдачу. Для полной
// перевыгрузки по расписанию это безразлично, но опираться на такой порядок
// при переходе к инкрементальному обмену нельзя.
//
// Списками без курсора отдаются цены и остатки: они привязаны не к одному
// объекту, а к паре «товар — вид цены» и «товар — склад», и курсор по ним
// не строится. Их объём ограничен числом позиций номенклатуры.
//
// ЧИСЛА ПЕРЕДАЮТСЯ СТРОКАМИ, включая координаты. JSON не различает 1.10 и
// 1.1, а разбор чисел с плавающей точкой на принимающей стороне добавляет
// свою погрешность. Разделитель — точка, разрядов групп нет.
//
// ОТСУТСТВУЮЩИЕ ЗНАЧЕНИЯ — всегда пустая строка, никогда не null: иначе
// принимающей стороне пришлось бы разбирать оба случая для одного поля.
// Поэтому разыменования обёрнуты в ЕСТЬNULL прямо в запросах.
//
// АУТЕНТИФИКАЦИЯ — по токену (см. область Авторизация). Обращается доверенный
// сервер SmartSale-посредник под одним сервисным токеном; за какого агента
// идёт запрос, он указывает параметром `agent`. Публикация настроена так,
// что веб-сервер свою аутентификацию не требует — единственный рубеж токен.
// Запросы идут с «РАЗРЕШЕННЫЕ»: под ограниченными правами служебной учётной
// записи выборка должна молча сузиться, а не упасть.
//
// АГЕНТ И СКЛАД. У каждого агента ровно один склад: связь «агент → склад,
// подразделение, организация» лежит в регистре SmartSale_СкладыАгентов.
// Остатки агент видит только по своему складу, заказ проводится на него.
//
// Методы (корневой URL `smartsale`):
//   GET  /ping                  — проверка живости, без токена и данных
//   GET  /meta                  — организации, склады, виды цен, менеджеры
//   GET  /products?after=<uid>  — номенклатура и группы, страницами
//   GET  /prices?date=<ГГГГ-ММ-ДД|ISO> — цены на дату, списком целиком
//   GET  /stocks?agent=<uid>    — свободные остатки склада агента, списком
//   GET  /customers?after=<uid> — клиенты с контактами, страницами
//   POST /orders?agent=<uid>&dryrun=1 — приём заказов (dryrun — без записи)
//   POST /orders/state          — состояние ранее принятых заказов

#Область ОбработчикиСобытий

// Проверка связи. Данные не читает намеренно: приложению нужно отличать
// «сервис не отвечает» от «сервис отвечает, но запрос неверный».
//
// Обёрнут в Попытку наравне с остальными: без неё сбой сериализации вернул
// бы клиенту HTML-страницу ошибки платформы — ровно то, от чего метод
// должен защищать.
Функция pingGET(ВходящийЗапрос) Экспорт

	Попытка

		Данные = Новый Структура;
		Данные.Вставить("service", "smartsale");
		Данные.Вставить("protocol", ВерсияПротокола());
		Данные.Вставить("server_time", ВремяСервера());

		Возврат ОтветСДанными(Данные);

	Исключение
		Возврат ОтветОшибки(ИнформацияОбОшибке(), "ping");
	КонецПопытки;

КонецФункции

// Мелкие справочники одним ответом: их единицы, дробить незачем.
Функция metaGET(ВходящийЗапрос) Экспорт

	Отказ = ПроверитьТокен(ВходящийЗапрос);
	Если Отказ <> Неопределено Тогда
		Возврат Отказ;
	КонецЕсли;

	Попытка

		Данные = Новый Структура;
		Данные.Вставить("protocol", ВерсияПротокола());
		Данные.Вставить("server_time", ВремяСервера());
		Данные.Вставить("organizations", Организации());
		Данные.Вставить("warehouses", Склады());
		Данные.Вставить("price_types", ВидыЦен());
		Данные.Вставить("managers", Менеджеры());
		Данные.Вставить("agent_accounts", УчёткиАгентов());
		Данные.Вставить("agent_routes", МаршрутыАгентов());
		Данные.Вставить("agent_tasks", ЗаданияАгентов());
		Данные.Вставить("audit_questions", ВопросыАудита());

		Возврат ОтветСДанными(Данные);

	Исключение
		Возврат ОтветОшибки(ИнформацияОбОшибке(), "meta");
	КонецПопытки;

КонецФункции

