#КонецОбласти

#Область ВыборкиДанных

Функция Организации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СпрОрганизации.Ссылка) КАК УИД,
	|	СпрОрганизации.Наименование КАК Наименование,
	|	ЕСТЬNULL(СпрОрганизации.НаименованиеПолное, """") КАК НаименованиеПолное,
	|	ЕСТЬNULL(СпрОрганизации.ИНН, """") КАК ИНН,
	|	НЕ СпрОрганизации.ПометкаУдаления КАК Активна
	|ИЗ
	|	Справочник.Организации КАК СпрОрганизации
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("uid", Строка(Выборка.УИД));
		Элемент.Вставить("name", Выборка.Наименование);
		Элемент.Вставить("legal_name", СокрЛП(Выборка.НаименованиеПолное));
		Элемент.Вставить("inn", СокрЛП(Выборка.ИНН));
		Элемент.Вставить("active", Выборка.Активна);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

