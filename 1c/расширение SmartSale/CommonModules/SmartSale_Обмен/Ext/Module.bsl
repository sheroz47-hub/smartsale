// Приём заказов клиентов из SmartSale и ответ о состоянии ранее принятых.
//
// Серверный общий модуль расширения. HTTP-специфики здесь нет: методы
// возвращают структуры данных, а модуль сервиса оборачивает их в ответ.
// Ошибка уровня всего пакета поднимается исключением — сервис отдаёт её
// кодом 400/500. Ошибка уровня одного заказа не прерывает пакет: заказ
// отвечает за себя строкой в results.
//
// ЧТО ПРИХОДИТ. Тело приёма — {"orders": [<заказ>, ...]}, заказ:
//   client_uid   — ключ идемпотентности, генерирует телефон
//   customer_uid — идентификатор ссылки партнёра (из /customers)
//   date         — дата оформления агентом, ГГГГ-ММ-ДД (в комментарий)
//   comment      — комментарий агента
//   lines        — [{product_uid, qty, price}, ...]
// Агент (менеджер) приходит НЕ в теле, а параметром запроса ?agent=<uid>:
// сервер SmartSale подставляет его сам, и по нему берётся организация,
// склад и подразделение из регистра SmartSale_СкладыАгентов.
//
// ЧЕМ ЗАПОЛНЯЕТСЯ ЗАКАЗ. Организация/склад/подразделение — из регистра
// агента. Валюта — управленческого учёта (в базе одна). Ставка НДС —
// основная по стране (12%), а не из номенклатуры: у товаров стоит «Без
// НДС», но реализация облагается, как в существующих заказах базы. Цена
// берётся из строки заказа, а НЕ пересчитывается: автоподстановка цены в
// этой базе не работает, и обещанная агентом клиенту цена меняться не
// должна. Цена трактуется как включающая НДС — так заведены заказы в базе.
//
// ПРОВЕДЕНИЕ. Заказ проводится сразу (решение пользователя) в статусе «На
// согласовании» — единственном допустимом при выключенных расширенных
// возможностях заказа. Режим dryrun проводит в транзакции и откатывает:
// боевой документ не создаётся, но видно, прошло бы проведение.
//
// ИДЕМПОТЕНТНОСТЬ. В журнал SmartSale_ЖурналПриема попадают ТОЛЬКО успешно
// проведённые заказы. Есть запись по client_uid — возвращаем её номер,
// второй заказ не создаём. Отказы не журналируются: транзиентный сбой не
// должен «отравить» client_uid навсегда, повтор проходит заново. От гонки
// двух запросов с одним client_uid защищает исключительная блокировка по
// ключу с повторной проверкой под ней (см. СоздатьПровестиОтветить).

#Область ПрограммныйИнтерфейс

// Приём пакета заказов.
//
// Параметры:
//  Пакет          - Структура - разобранное тело запроса, ждём ключ "orders".
//  Агент          - СправочникСсылка.Пользователи - менеджер заказов пакета.
//  ТолькоПроверка - Булево - dryrun: провести и откатить, не сохраняя.
//
// Возвращаемое значение:
//  Структура - results (Массив структур по каждому заказу), server_time.
Функция ПринятьПакетЗаказов(Знач Пакет, Знач Агент, Знач ТолькоПроверка) Экспорт

	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("orders") Тогда
		ВызватьИсключение "Ожидается объект с массивом «orders».";
	КонецЕсли;

	Заказы = Пакет.orders;
	Если ТипЗнч(Заказы) <> Тип("Массив") Тогда
		ВызватьИсключение "«orders» должен быть массивом.";
	КонецЕсли;

	// Данные агента берём один раз на пакет: они общие для всех заказов и
	// незачем читать регистр на каждый. Ошибка здесь — вина настройки, а не
	// конкретного заказа, поэтому поднимается на весь пакет.
	ДанныеАгента = СведенияАгента(Агент);

	Результаты = Новый Массив;

	Для Каждого Заказ Из Заказы Цикл
		// Каждый заказ отвечает за себя: непойманное исключение из его
		// обработки (блокировка, журнал, недоступный объект) не должно
		// ронять весь пакет 500-ым — иначе клиент не узнает, что прошло.
		Попытка
			Результаты.Добавить(ПринятьЗаказ(Заказ, Агент, ДанныеАгента, ТолькоПроверка));
		Исключение
			Результаты.Добавить(АварийныйРезультат(Заказ, ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("protocol", "1.0");
	Ответ.Вставить("server_time", ВремяСервера());
	Ответ.Вставить("dryrun", ТолькоПроверка);
	Ответ.Вставить("results", Результаты);

	Возврат Ответ;

КонецФункции

// Приём пакета оплат (приходных кассовых ордеров).
//
// Оплата садится в счёт ОБЩЕГО долга клиента: расшифровка платежа без
// привязки к конкретному заказу. Проведение и идемпотентность — как у
// заказов, тем же журналом и той же общей функцией проведения.
//
// Параметры:
//  Пакет          - Структура - ждём ключ "payments".
//  Агент          - СправочникСсылка.Пользователи - от него организация и касса.
//  ТолькоПроверка - Булево - dryrun.
//
// Возвращаемое значение:
//  Структура - results, server_time.
Функция ПринятьПакетОплат(Знач Пакет, Знач Агент, Знач ТолькоПроверка) Экспорт

	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("payments") Тогда
		ВызватьИсключение "Ожидается объект с массивом «payments».";
	КонецЕсли;

	Оплаты = Пакет.payments;
	Если ТипЗнч(Оплаты) <> Тип("Массив") Тогда
		ВызватьИсключение "«payments» должен быть массивом.";
	КонецЕсли;

	ДанныеАгента = СведенияАгента(Агент);

	Результаты = Новый Массив;

	Для Каждого Оплата Из Оплаты Цикл
		Попытка
			Результаты.Добавить(ПринятьОплату(Оплата, Агент, ДанныеАгента, ТолькоПроверка));
		Исключение
			Результаты.Добавить(АварийныйРезультат(Оплата, ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("protocol", "1.0");
	Ответ.Вставить("server_time", ВремяСервера());
	Ответ.Вставить("dryrun", ТолькоПроверка);
	Ответ.Вставить("results", Результаты);

	Возврат Ответ;

КонецФункции

// Состояние ранее принятых заказов.
//
// Параметры:
//  Пакет - Структура - ждём ключ "client_uids" (массив строк).
//
// Возвращаемое значение:
//  Структура - results (по каждому client_uid), server_time.
Функция СостояниеЗаказов(Знач Пакет) Экспорт

	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("client_uids") Тогда
		ВызватьИсключение "Ожидается объект с массивом «client_uids».";
	КонецЕсли;

	Ключи = Пакет.client_uids;
	Если ТипЗнч(Ключи) <> Тип("Массив") Тогда
		ВызватьИсключение "«client_uids» должен быть массивом.";
	КонецЕсли;

	Записи = ЗаписиЖурнала(Ключи);
	Результаты = Новый Массив;

	Для Каждого Ключ Из Ключи Цикл

		НормКлюч = СокрЛП(Строка(Ключ));

		СтрокаОтвета = Новый Структура;
		СтрокаОтвета.Вставить("client_uid", НормКлюч);

		Запись = Записи[НормКлюч];
		Если Запись = Неопределено Тогда
			СтрокаОтвета.Вставить("known", Ложь);
		Иначе
			СтрокаОтвета.Вставить("known", Истина);
			СтрокаОтвета.Вставить("accepted", Запись.Принят);
			СтрокаОтвета.Вставить("number", Запись.Номер);
			СтрокаОтвета.Вставить("state", Запись.Состояние);
			СтрокаОтвета.Вставить("cancelled", Запись.Отменен);
			СтрокаОтвета.Вставить("error", Запись.Ошибка);
		КонецЕсли;

		Результаты.Добавить(СтрокаОтвета);

	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("protocol", "1.0");
	Ответ.Вставить("server_time", ВремяСервера());
	Ответ.Вставить("results", Результаты);

	Возврат Ответ;

КонецФункции

// Приём отметок выполнения заданий от агента. Тело — {"tasks":[{uid, comment}]}.
// Каждое задание отвечает за себя; непойманное исключение по одному не роняет
// пакет. Идемпотентно: повторная отметка выполненного задания безвредна.
Функция ПринятьВыполнениеЗаданий(Знач Пакет) Экспорт

	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("tasks") Тогда
		ВызватьИсключение "Ожидается объект с массивом «tasks».";
	КонецЕсли;

	Задания = Пакет.tasks;
	Если ТипЗнч(Задания) <> Тип("Массив") Тогда
		ВызватьИсключение "«tasks» должен быть массивом.";
	КонецЕсли;

	Результаты = Новый Массив;
	Для Каждого Задание Из Задания Цикл
		Попытка
			Результаты.Добавить(ОтметитьЗадание(Задание));
		Исключение
			Стр = Новый Структура;
			Стр.Вставить("uid", ЗначениеПоля(Задание, "uid"));
			Стр.Вставить("status", "rejected");
			Стр.Вставить("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результаты.Добавить(Стр);
		КонецПопытки;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("protocol", "1.0");
	Ответ.Вставить("server_time", ВремяСервера());
	Ответ.Вставить("results", Результаты);

	Возврат Ответ;

КонецФункции

// Отметить одно задание выполненным: флаг, дата и комментарий агента.
Функция ОтметитьЗадание(Знач Задание)

	Результат = Новый Структура;
	Результат.Вставить("uid", ЗначениеПоля(Задание, "uid"));
	Результат.Вставить("status", "rejected");
	Результат.Вставить("error", "");

	УИД = ЗначениеПоля(Задание, "uid");
	Если ПустаяСтрока(УИД) Тогда
		Результат.error = "Не заполнен uid задания.";
		Возврат Результат;
	КонецЕсли;

	СсылкаЗадания = СсылкаПоУИД(Справочники.SmartSale_Задания, УИД, "uid");
	ЗаданиеОбъект = СсылкаЗадания.ПолучитьОбъект();
	ЗаданиеОбъект.Выполнено = Истина;
	ЗаданиеОбъект.ДатаВыполнения = ТекущаяДатаСеанса();
	ЗаданиеОбъект.КомментарийВыполнения = ЗначениеПоля(Задание, "comment");
	ЗаданиеОбъект.Записать();

	Результат.status = "accepted";
	Возврат Результат;

КонецФункции

// Приём фотоотчёта к заданию. Фото прикладывается как присоединённый файл (БСП)
// к КЛИЕНТУ задания (Справочник.Партнеры уже владелец присоединённых файлов —
// «скрепка» карточки партнёра), ложится в том хранения по дате, менеджер
// открывает в карточке клиента. В описании файла — ссылка на задание (текст и
// дата), чтобы отчёт был опознаваем. Одно фото — один вызов. Идемпотентно по
// имени файла (uuid снимка с телефона): повторная доставка второй файл не
// создаёт.
Функция ОтметитьЗаданиеФайлом(Знач УИДЗадания, Знач ИмяФайла, Знач ДвоичныеДанные) Экспорт

	Результат = Новый Структура("status, error", "rejected", "");

	Если ПустаяСтрока(УИДЗадания) Тогда
		Результат.error = "Не заполнен uid задания.";
		Возврат Результат;
	КонецЕсли;
	Если ПустаяСтрока(ИмяФайла) Тогда
		Результат.error = "Не заполнено имя файла.";
		Возврат Результат;
	КонецЕсли;
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		Результат.error = "Пустое тело файла.";
		Возврат Результат;
	КонецЕсли;

	// Пропавшее задание/клиент — постоянный отказ (status rejected), а не
	// исключение: шина по нему бросает фото из буфера, а не гоняет вечно. Сбой
	// хранения (том, запись файла) — это уже исключение из ПриложитьФотоКлиенту,
	// оно поднимется наверх, шина повторит на следующем прогоне.
	Задание = ЗаданиеПоУИД(УИДЗадания);
	Если Задание = Неопределено Тогда
		Результат.error = "Задание не найдено на сервере.";
		Возврат Результат;
	КонецЕсли;

	Клиент = Задание.Клиент;
	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Результат.error = "У задания не указан клиент — фото приложить некуда.";
		Возврат Результат;
	КонецЕсли;

	Если ФайлКлиентаСуществует(Клиент, ИмяФайла) Тогда
		Результат.status = "accepted";
		Возврат Результат;
	КонецЕсли;

	ПриложитьФотоКлиенту(Клиент, ИмяФайла, ДвоичныеДанные, ОписаниеЗадания(Задание));

	Результат.status = "accepted";
	Возврат Результат;

КонецФункции

// Приём уточнённых координат клиентов. Тело —
// {"locations":[{customer_uid, lat, lon}]}. Координаты пишутся в контактную
// информацию головного контрагента партнёра — тот же источник, откуда их
// читает выгрузка /customers, так что уточнённая точка вернётся агенту
// обменом. Каждая запись отвечает за себя, непойманное исключение по одной не
// роняет пакет.
Функция ОбновитьКоординатыКлиента(Знач Пакет) Экспорт

	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("locations") Тогда
		ВызватьИсключение "Ожидается объект с массивом «locations».";
	КонецЕсли;

	Записи = Пакет.locations;
	Если ТипЗнч(Записи) <> Тип("Массив") Тогда
		ВызватьИсключение "«locations» должен быть массивом.";
	КонецЕсли;

	Результаты = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Попытка
			Результаты.Добавить(ОбновитьКоординатыОдну(Запись));
		Исключение
			Стр = Новый Структура;
			Стр.Вставить("customer_uid", ЗначениеПоля(Запись, "customer_uid"));
			Стр.Вставить("status", "rejected");
			Стр.Вставить("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результаты.Добавить(Стр);
		КонецПопытки;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("protocol", "1.0");
	Ответ.Вставить("server_time", ВремяСервера());
	Ответ.Вставить("results", Результаты);

	Возврат Ответ;

КонецФункции

// Приём результатов аудита точек. Тело —
// {"audits":[{client_uid, customer_uid, agent_uid, date, answers:[{question_uid, value}]}]}.
// Один аудит — набор ответов, пишется в регистр SmartSale_РезультатыАудита
// набором по КлючАудита с замещением: повтор доставки одного аудита
// перезаписывает его строки, дублей нет. Каждый аудит отвечает за себя.
Функция ПринятьАудиты(Знач Пакет) Экспорт

	Если ТипЗнч(Пакет) <> Тип("Структура") Или Не Пакет.Свойство("audits") Тогда
		ВызватьИсключение "Ожидается объект с массивом «audits».";
	КонецЕсли;

	Аудиты = Пакет.audits;
	Если ТипЗнч(Аудиты) <> Тип("Массив") Тогда
		ВызватьИсключение "«audits» должен быть массивом.";
	КонецЕсли;

	Результаты = Новый Массив;
	Для Каждого Аудит Из Аудиты Цикл
		Попытка
			Результаты.Добавить(ЗаписатьАудит(Аудит));
		Исключение
			Стр = Новый Структура;
			Стр.Вставить("client_uid", ЗначениеПоля(Аудит, "client_uid"));
			Стр.Вставить("status", "rejected");
			Стр.Вставить("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Результаты.Добавить(Стр);
		КонецПопытки;
	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("protocol", "1.0");
	Ответ.Вставить("server_time", ВремяСервера());
	Ответ.Вставить("results", Результаты);

	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СведенияАгентаОбласть

// Организация, склад, подразделение и касса агента из регистра расширения.
//
// Всё для шапки заказа и ПКО лежит одной записью: у складов в этой базе нет
// привязки к организации, поэтому организацию продаж задаёт регистр агента.
// Пустой склад недопустим — по нему проводится заказ и фильтруются остатки.
// У агента ровно один склад и одна касса (так решено), берётся первая запись.
//
// Параметры:
//  Агент - СправочникСсылка.Пользователи.
//
// Возвращаемое значение:
//  Структура - Организация, Склад, Подразделение, Касса.
Функция СведенияАгента(Знач Агент) Экспорт

	Если Агент = Справочники.Пользователи.ПустаяСсылка() Тогда
		ВызватьИсключение "Не указан агент (параметр «agent»).";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СкладыАгентов.Организация КАК Организация,
	|	СкладыАгентов.Склад КАК Склад,
	|	СкладыАгентов.Подразделение КАК Подразделение,
	|	СкладыАгентов.Касса КАК Касса
	|ИЗ
	|	РегистрСведений.SmartSale_СкладыАгентов КАК СкладыАгентов
	|ГДЕ
	|	СкладыАгентов.Пользователь = &Агент
	|	И СкладыАгентов.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон(
			"Для агента «%1» не задан склад. Заполните регистр SmartSale_СкладыАгентов.",
			Строка(Агент));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Организация", Выборка.Организация);
	Результат.Вставить("Склад", Выборка.Склад);
	Результат.Вставить("Подразделение", Выборка.Подразделение);
	Результат.Вставить("Касса", Выборка.Касса);

	Возврат Результат;

КонецФункции

// Склад для отбора остатков. Пустой агент → пустая ссылка, что значит «без
// ограничения»: полную выгрузку остатков сервер SmartSale делает без agent.
// С агентом склад обязателен — иначе отказ, чтобы агент не увидел чужой
// остаток.
Функция СкладОтбораОстатков(Знач Агент) Экспорт

	Если Агент = Справочники.Пользователи.ПустаяСсылка() Тогда
		Возврат Справочники.Склады.ПустаяСсылка();
	КонецЕсли;

	Возврат СведенияАгента(Агент).Склад;

КонецФункции

#КонецОбласти

#Область ПриемОдногоЗаказа

Функция ПринятьЗаказ(Знач Заказ, Знач Агент, Знач ДанныеАгента, Знач ТолькоПроверка)

	КлючИдемпотентности = ЗначениеПоля(Заказ, "client_uid");

	Результат = Новый Структура;
	Результат.Вставить("client_uid", КлючИдемпотентности);
	Результат.Вставить("status", "rejected");
	Результат.Вставить("number", "");
	Результат.Вставить("error", "");

	Если ПустаяСтрока(КлючИдемпотентности) Тогда
		Результат.error = "Не заполнен client_uid.";
		Возврат Результат;
	КонецЕсли;

	// В журнал попадают только успешно принятые заказы. Есть запись —
	// заказ уже проведён, повтор возвращает его номер, второй не создаём.
	// Отказы НЕ журналируются: транзиентный сбой (блокировка, временно
	// недоступная ссылка) не должен «отравить» client_uid навсегда —
	// повтор такого заказа проходит заново.
	Если Не ТолькоПроверка Тогда
		Прежний = НайтиВЖурнале(КлючИдемпотентности);
		Если Прежний <> Неопределено Тогда
			Результат.status = "accepted";
			Результат.number = Прежний.Номер;
			Результат.Вставить("duplicate", Истина);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	// Ошибка разбора и формирования — наши понятные тексты («не заполнено
	// поле», «заказ без строк»); их безопасно отдавать клиенту как есть.
	// Формирование объекта — вне транзакции: это заполнение в памяти.
	Попытка
		ДанныеЗаказа = РазобратьЗаказ(Заказ, Агент, ДанныеАгента);
		ДокОбъект = СформироватьЗаказ(ДанныеЗаказа);
	Исключение
		Результат.error = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Возврат СоздатьПровестиДокумент(ДокОбъект, "заказа", КлючИдемпотентности, ТолькоПроверка, Результат);

КонецФункции

// Создание и проведение одного документа в транзакции. Общая для заказа и
// приходного кассового ордера: объект уже сформирован в памяти, здесь —
// только проведение, идемпотентность и журнал.
//
// dryrun всегда откатывает транзакцию: боевого документа не остаётся.
// Боевой режим под исключительной блокировкой по ключу идемпотентности:
// два одновременных запроса с одним client_uid сериализуются, второй под
// блокировкой видит запись первого и не создаёт дубль. Без блокировки оба
// прошли бы проверку «записи нет» и провели по документу каждый.
//
// Параметры:
//  ДокОбъект      - ДокументОбъект - сформированный, но не записанный.
//  РодДокумента   - Строка - «заказа»/«платежа» для текста ошибки.
//  Ключ           - Строка - client_uid.
//  ТолькоПроверка - Булево - dryrun.
//  Результат      - Структура - заполняется и возвращается.
//  Привилегированно - Булево - проводить документ в привилегированном режиме
//                     (для ПКО: кассовый ордер двигает финансовые регистры,
//                     права на которые сервисной учётке не выдаются). Заказы
//                     проводятся под правами пользователя — им передаётся Ложь.
Функция СоздатьПровестиДокумент(ДокОбъект, Знач РодДокумента, Знач Ключ, Знач ТолькоПроверка, Результат, Знач Привилегированно = Ложь)

	НачатьТранзакцию();

	Попытка

		Если Не ТолькоПроверка Тогда

			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.SmartSale_ЖурналПриема");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("КлючИдемпотентности", Ключ);
			Блокировка.Заблокировать();

			// Повторная проверка под блокировкой: пока ждали блокировку,
			// конкурент мог создать документ.
			Прежний = НайтиВЖурнале(Ключ);
			Если Прежний <> Неопределено Тогда
				ЗафиксироватьТранзакцию();
				Результат.status = "accepted";
				Результат.number = Прежний.Номер;
				Результат.Вставить("duplicate", Истина);
				Возврат Результат;
			КонецЕсли;

		КонецЕсли;

		// Причину отказа платформа кладёт не в исключение («Не удалось
		// провести»), а в сообщения пользователю — их собираем в блоке
		// Исключение через ПолучитьСообщенияПользователю.
		ПровестиДокумент(ДокОбъект, Привилегированно);

		Номер = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокОбъект.Номер, Истина, Истина);

		Если ТолькоПроверка Тогда
			ОтменитьТранзакцию();
			Результат.status = "accepted";
			Результат.number = Номер;
			Результат.Вставить("would_post", Истина);
			Возврат Результат;
		КонецЕсли;

		ЗаписатьВЖурнал(Ключ, ДокОбъект.Ссылка, Истина, "");
		ЗафиксироватьТранзакцию();

		Результат.status = "accepted";
		Результат.number = Номер;
		Возврат Результат;

	Исключение

		ИнфОшибки = ИнформацияОбОшибке();
		ТекстСообщений = СобратьСообщенияПользователю();

		ОтменитьТранзакцию();

		// Текст отказа проведения — от платформы, содержит имена реквизитов
		// и таблиц. Наружу, в интернет-канал, он не уходит: клиенту метка,
		// подробность (исключение + сообщения проведения) — в журнал
		// регистрации по ней. Отказ НЕ журналируется в SmartSale_ЖурналПриема,
		// поэтому повтор возможен.
		Метка = Строка(Новый УникальныйИдентификатор());
		ЗаписатьОшибкуВЖР(Ключ, Метка, ИнфОшибки, ТекстСообщений);
		Результат.error = "Ошибка проведения " + РодДокумента + ". trace_id " + Метка;

		Возврат Результат;

	КонецПопытки;

КонецФункции

// Проведение документа, при необходимости — в привилегированном режиме.
//
// Привилегированный режим включается ТОЛЬКО на время этого вызова: платформа
// сбрасывает его при выходе из процедуры, в том числе когда проведение
// падает исключением и управление уходит наверх. Поэтому отдельная процедура,
// а не установка режима в СоздатьПровестиДокумент с ручным сбросом на всех
// путях выхода — здесь сброс гарантирован платформой.
//
// Режим действует на весь стек проведения (ОбработкаПроведения, запись
// движений регистров). Нужен для ПКО: кассовый ордер двигает финансовые
// регистры (управленческий баланс «АктивыИПассивы» и др.), давать права на
// которые сервисной учётке обмена нежелательно. Документ уже сформирован
// проверенным кодом приёма, сервис — доверенный посредник под одним токеном,
// поэтому проведение под полными правами здесь оправдано. Заказы проводятся
// под правами пользователя (Привилегированно = Ложь) — контроль прав на них
// сохраняется.
Процедура ПровестиДокумент(ДокОбъект, Знач Привилегированно)

	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

// Результат для заказа, чья обработка упала непойманным исключением.
// Текст прячется за меткой — исключение здесь того же рода, что и отказ
// проведения (платформенное), и раскрывать его наружу нельзя.
Функция АварийныйРезультат(Знач Заказ, Знач ИнфОшибки)

	Метка = Строка(Новый УникальныйИдентификатор());
	Ключ = ЗначениеПоля(Заказ, "client_uid");
	ЗаписатьОшибкуВЖР(Ключ, Метка, ИнфОшибки);

	Результат = Новый Структура;
	Результат.Вставить("client_uid", Ключ);
	Результат.Вставить("status", "rejected");
	Результат.Вставить("number", "");
	Результат.Вставить("error", "Внутренняя ошибка приёма. trace_id " + Метка);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ПриемОднойОплаты

Функция ПринятьОплату(Знач Оплата, Знач Агент, Знач ДанныеАгента, Знач ТолькоПроверка)

	КлючКлиента = ЗначениеПоля(Оплата, "client_uid");

	Результат = Новый Структура;
	Результат.Вставить("client_uid", КлючКлиента);
	Результат.Вставить("status", "rejected");
	Результат.Вставить("number", "");
	Результат.Вставить("error", "");

	Если ПустаяСтрока(КлючКлиента) Тогда
		Результат.error = "Не заполнен client_uid.";
		Возврат Результат;
	КонецЕсли;

	// Заказы и оплаты делят один регистр идемпотентности, а телефон
	// генерирует client_uid независимо в каждом потоке. Ключ оплаты
	// префиксуется, чтобы совпадение uid заказа и оплаты не привело к
	// возврату номера чужого документа и пропуску создания ПКО. Клиенту в
	// ответе уходит исходный client_uid, префикс — только внутренний ключ.
	КлючЖурнала = "pay:" + КлючКлиента;

	Если Не ТолькоПроверка Тогда
		Прежний = НайтиВЖурнале(КлючЖурнала);
		Если Прежний <> Неопределено Тогда
			Результат.status = "accepted";
			Результат.number = Прежний.Номер;
			Результат.Вставить("duplicate", Истина);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Попытка
		ДанныеОплаты = РазобратьОплату(Оплата, ДанныеАгента);
		ДокОбъект = СформироватьПКО(ДанныеОплаты);
	Исключение
		Результат.error = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	// Привилегированно = Истина: ПКО двигает финансовые регистры, права на
	// которые сервисной учётке не выданы (см. ПровестиДокумент).
	Возврат СоздатьПровестиДокумент(ДокОбъект, "оплаты", КлючЖурнала, ТолькоПроверка, Результат, Истина);

КонецФункции

// Разбор входной оплаты. Сумма приходит строкой, партнёр — идентификатором.
//
// Проверки касса-валюта и наличие контрагента вынесены сюда до транзакции:
// оба случая иначе упали бы уже на проведении, а причина проведения прячется
// за trace_id и в журнал приёма НЕ пишется — приложение повторяло бы такой
// платёж без конца. Отказ на разборе возвращается клиенту понятным текстом,
// по нему приложение видит, что повтор бессмыслен.
Функция РазобратьОплату(Знач Оплата, Знач ДанныеАгента)

	Если ДанныеАгента.Касса = Справочники.Кассы.ПустаяСсылка() Тогда
		ВызватьИсключение "Для агента не задана касса. Заполните регистр SmartSale_СкладыАгентов.";
	КонецЕсли;

	// Валютой ПКО фактически управляет касса. Ставим валюту учёта (UZS), и
	// если касса ведётся в другой валюте, проведение упадёт. Ловим заранее.
	ВалютаКассы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ДанныеАгента.Касса, "ВалютаДенежныхСредств");
	Если ВалютаКассы <> Константы.ВалютаУправленческогоУчета.Получить() Тогда
		ВызватьИсключение "Валюта кассы агента не совпадает с валютой учёта — оплату принять нельзя.";
	КонецЕсли;

	Партнер = СсылкаПоУИД(Справочники.Партнеры, ЗначениеПоля(Оплата, "customer_uid"), "customer_uid");

	// Контрагент («Плательщик») в шапке ПКО обязателен для проведения. У
	// партнёра он может отсутствовать (в базе такой один из 4471) — тогда
	// понятный отказ, а не платёжный документ, который не проведётся.
	Контрагент = ГоловнойКонтрагент(Партнер);
	Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		ВызватьИсключение "У клиента не заполнен контрагент — приходный ордер оформить нельзя.";
	КонецЕсли;

	Сумма = ЧислоИзПоля(Оплата, "amount");
	Если Сумма <= 0 Тогда
		ВызватьИсключение "Нулевая или отрицательная сумма оплаты.";
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("Партнер", Партнер);
	Данные.Вставить("Контрагент", Контрагент);
	Данные.Вставить("Организация", ДанныеАгента.Организация);
	Данные.Вставить("Подразделение", ДанныеАгента.Подразделение);
	Данные.Вставить("Касса", ДанныеАгента.Касса);
	СведенияДоговора = ДействующийДоговор(Партнер, ДанныеАгента.Организация);
	Данные.Вставить("Договор", СведенияДоговора.Ссылка);
	Данные.Вставить("ОбъектРасчетов", СведенияДоговора.ОбъектРасчетов);
	Данные.Вставить("Сумма", Сумма);
	Данные.Вставить("Комментарий", СборныйКомментарий(Оплата));

	Возврат Данные;

КонецФункции

// Заполнение приходного кассового ордера «Поступление оплаты от клиента».
//
// Оплата в счёт ОБЩЕГО долга КЛИЕНТА по договору: расшифровка платежа
// ссылается на договор (основание платежа), а не на конкретный заказ. Так
// оплата гасит общий долг по договору, а заказы, проведённые по тому же
// договору, автоматически с ней сходятся. Объект расчётов берётся из реквизита
// самого договора (ДействующийДоговор): это тот же служебный элемент, на
// который заказ кладёт долг. Через него, а не через ОбъектыРасчетовСервер
// (она умеет создавать элемент — запись в справочник под сервисной учёткой в
// безопасном режиме расширения упала бы). Статья ДДС — предопределённая
// «Поступление оплаты от клиента».
Функция СформироватьПКО(Знач Данные)

	Валюта = Константы.ВалютаУправленческогоУчета.Получить();

	ДокОбъект = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	ДокОбъект.Организация = Данные.Организация;
	ДокОбъект.Подразделение = Данные.Подразделение;
	ДокОбъект.Касса = Данные.Касса;
	ДокОбъект.Партнер = Данные.Партнер;
	ДокОбъект.Контрагент = Данные.Контрагент;
	ДокОбъект.Валюта = Валюта;
	ДокОбъект.СуммаДокумента = Данные.Сумма;
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
	ДокОбъект.ПринятоОт = Строка(Данные.Контрагент);
	ДокОбъект.Комментарий = Данные.Комментарий;

	СтрокаРасшифровки = ДокОбъект.РасшифровкаПлатежа.Добавить();
	СтрокаРасшифровки.Партнер = Данные.Партнер;
	СтрокаРасшифровки.Организация = Данные.Организация;
	СтрокаРасшифровки.ОснованиеПлатежа = Данные.Договор;
	СтрокаРасшифровки.ОбъектРасчетов = Данные.ОбъектРасчетов;
	СтрокаРасшифровки.Сумма = Данные.Сумма;
	СтрокаРасшифровки.ВалютаВзаиморасчетов = Валюта;
	СтрокаРасшифровки.СуммаВзаиморасчетов = Данные.Сумма;
	СтрокаРасшифровки.КурсЧислительВзаиморасчетов = 1;
	СтрокаРасшифровки.КурсЗнаменательВзаиморасчетов = 1;
	СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств =
		Справочники.СтатьиДвиженияДенежныхСредств.ПоступлениеОплатыОтКлиента;

	Возврат ДокОбъект;

КонецФункции

#КонецОбласти

#Область РазборИЗаполнение

// Разбор входного заказа в структуру ссылок и строк 1С.
//
// Все ссылки проверяются на существование сразу: неверный uid лучше
// отклонить понятной ошибкой, чем провести заказ с пустым партнёром.
Функция РазобратьЗаказ(Знач Заказ, Знач Агент, Знач ДанныеАгента)

	Если Агент = Справочники.Пользователи.ПустаяСсылка() Тогда
		ВызватьИсключение "Не указан агент (параметр «agent»).";
	КонецЕсли;

	Партнер = СсылкаПоУИД(Справочники.Партнеры, ЗначениеПоля(Заказ, "customer_uid"), "customer_uid");

	СтрокиВхода = ?(Заказ.Свойство("lines"), Заказ.lines, Неопределено);
	Если ТипЗнч(СтрокиВхода) <> Тип("Массив") Или СтрокиВхода.Количество() = 0 Тогда
		ВызватьИсключение "Заказ без строк.";
	КонецЕсли;

	СтавкаНДС = ОсновнаяСтавкаНДС();

	Строки = Новый Массив;
	Для Каждого Линия Из СтрокиВхода Цикл

		Номенклатура = СсылкаПоУИД(Справочники.Номенклатура, ЗначениеПоля(Линия, "product_uid"), "product_uid");

		Количество = ЧислоИзПоля(Линия, "qty");
		Если Количество <= 0 Тогда
			ВызватьИсключение "Нулевое или отрицательное количество в строке.";
		КонецЕсли;

		Цена = ЧислоИзПоля(Линия, "price");
		Если Цена < 0 Тогда
			ВызватьИсключение "Отрицательная цена в строке.";
		КонецЕсли;

		// Скидка приходит уже посчитанной суммой на строку: акции считает
		// движок SmartSale, а в УТ они садятся как ручная скидка. Поле
		// необязательное — при отсутствии скидки ноль. Скидка не может
		// превышать сумму строки.
		СуммаСкидки = ЧислоИзПоля(Линия, "discount_amount");
		Если СуммаСкидки < 0 Тогда
			ВызватьИсключение "Отрицательная скидка в строке.";
		КонецЕсли;
		Если СуммаСкидки > Количество * Цена Тогда
			ВызватьИсключение "Скидка больше суммы строки.";
		КонецЕсли;

		СтрокаЗаказа = Новый Структура;
		СтрокаЗаказа.Вставить("Номенклатура", Номенклатура);
		СтрокаЗаказа.Вставить("Количество", Количество);
		СтрокаЗаказа.Вставить("Цена", Цена);
		СтрокаЗаказа.Вставить("СуммаСкидки", СуммаСкидки);
		Строки.Добавить(СтрокаЗаказа);

	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("Агент", Агент);
	Данные.Вставить("Партнер", Партнер);
	Данные.Вставить("Контрагент", ГоловнойКонтрагент(Партнер));
	Данные.Вставить("Организация", ДанныеАгента.Организация);
	Данные.Вставить("Склад", ДанныеАгента.Склад);
	Данные.Вставить("Подразделение", ДанныеАгента.Подразделение);
	Данные.Вставить("Договор", ДействующийДоговор(Партнер, ДанныеАгента.Организация).Ссылка);
	Данные.Вставить("СтавкаНДС", СтавкаНДС.Ставка);
	Данные.Вставить("ПроцентНДС", СтавкаНДС.Процент);
	Данные.Вставить("Комментарий", СборныйКомментарий(Заказ));
	Данные.Вставить("ДатаОтгрузки", ДатаОтгрузкиЗаказа(Заказ));
	Данные.Вставить("Строки", Строки);

	Возврат Данные;

КонецФункции

// Заполнение объекта заказа. Значения шапки повторяют существующие
// проведённые заказы базы: операция «Реализация клиенту», расчёты «По
// заказам», цена включает НДС, статус «На согласовании».
Функция СформироватьЗаказ(Знач Данные)

	ДокОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДатаСеанса();

	ДокОбъект.Организация    = Данные.Организация;
	ДокОбъект.Склад          = Данные.Склад;
	ДокОбъект.Подразделение  = Данные.Подразделение;
	ДокОбъект.Партнер        = Данные.Партнер;
	ДокОбъект.Контрагент     = Данные.Контрагент;
	ДокОбъект.Менеджер       = Данные.Агент;
	ДокОбъект.Валюта         = Константы.ВалютаУправленческогоУчета.Получить();
	ДокОбъект.ЦенаВключаетНДС = Истина;
	ДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;

	// Взаиморасчёты в этой базе ведутся по договорам: заказ ссылается на
	// действующий договор клиента, оплата ПКО гасит долг по тому же договору.
	// Порядок «По заказам» дал бы долг на заказе, который оплата «в счёт
	// общего долга» не закрыла бы.
	ДокОбъект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	ДокОбъект.Договор = Данные.Договор;
	ДокОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.НеСогласован;
	ДокОбъект.Комментарий = Данные.Комментарий;

	// Приоритет обязателен при ручном перепроведении из формы (наше
	// программное проведение проверку заполнения не запускает, а склад —
	// запускает). Ставим «Средний», чтобы заказ был корректным.
	ДокОбъект.Приоритет = ПриоритетПоУмолчанию();

	// Дата предполагаемой отгрузки — задаёт агент при оформлении (по
	// умолчанию завтра). Заказ отгружается ОДНОЙ датой (у нас одна дата на
	// заказ) — иначе УТ держит дату только по строкам, а шапку не заполняет.
	// Ставим и флаг, и дату в шапку и в строки.
	ДокОбъект.НеОтгружатьЧастями = Истина;
	ДокОбъект.ДатаОтгрузки = Данные.ДатаОтгрузки;

	// В базе включены автоматические скидки, и проведение требует, чтобы
	// они были рассчитаны. Мы их не применяем — скидки приходят готовыми от
	// движка SmartSale и садятся ручными, — поэтому помечаем «рассчитаны»:
	// пересчитывать нечего. Без флага проведение блокируется с требованием
	// «рассчитать автоматические скидки из формы документа».
	ДокОбъект.СкидкиРассчитаны = Истина;

	Если ЗначениеЗаполнено(ДокОбъект.Организация) Тогда
		ДокОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	КонецЕсли;

	// Вид цены строки берём у партнёра. Без вида цены УТ считает строку
	// «введённой по сумме» и при ручном перепроведении требует ненулевую
	// сумму (ПродажиСервер: «Не заполнена колонка "Сумма"») — а у бонуса
	// сумма 0. С видом цены строка «по цене»: контролируется цена (она есть),
	// нулевая сумма проходит. Если у партнёра вид цены не задан (он живёт на
	// соглашении, а не на карточке) — берём любой, лишь бы поле было заполнено
	// и строка считалась «по цене» (конкретный вид на контроль сумм не влияет).
	ВидЦеныЗаказа = ДокОбъект.Партнер.ВидЦен;
	Если Не ЗначениеЗаполнено(ВидЦеныЗаказа) Тогда
		ВидЦеныЗаказа = ВидЦеныПоУмолчанию();
	КонецЕсли;

	СуммаДокумента = 0;

	Для Каждого СтрокаДанных Из Данные.Строки Цикл

		СтрокаТЧ = ДокОбъект.Товары.Добавить();
		СтрокаТЧ.Номенклатура = СтрокаДанных.Номенклатура;
		СтрокаТЧ.Количество   = СтрокаДанных.Количество;
		СтрокаТЧ.ВидЦены      = ВидЦеныЗаказа;
		СтрокаТЧ.ДатаОтгрузки = Данные.ДатаОтгрузки;
		СтрокаТЧ.КоличествоУпаковок = СтрокаДанных.Количество;
		СтрокаТЧ.Цена         = СтрокаДанных.Цена;
		СтрокаТЧ.СтавкаНДС    = Данные.СтавкаНДС;
		СтрокаТЧ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.КОбеспечению;

		// Скидка садится ручной — акции считает движок SmartSale, а УТ
		// принимает готовую сумму. Заполняются и процент, и сумма: типовой
		// заказ хранит оба, а процент нужен для печатных форм.
		СуммаБезСкидки = СтрокаДанных.Количество * СтрокаДанных.Цена;
		СуммаСкидки = СтрокаДанных.СуммаСкидки;

		СтрокаТЧ.СуммаРучнойСкидки = СуммаСкидки;
		СтрокаТЧ.ПроцентРучнойСкидки = ?(СуммаБезСкидки = 0, 0,
			Окр(СуммаСкидки * 100 / СуммаБезСкидки, 2));

		// Цена включает НДС: сумма с НДС равна количество на цену за вычетом
		// скидки, НДС выделяется изнутри. Для ставки 12 %: НДС = сумма·12/112.
		Сумма = СуммаБезСкидки - СуммаСкидки;
		СуммаНДС = ?(Данные.ПроцентНДС = 0, 0,
			Окр(Сумма * Данные.ПроцентНДС / (100 + Данные.ПроцентНДС), 2));

		СтрокаТЧ.Сумма    = Сумма;
		СтрокаТЧ.СуммаНДС  = СуммаНДС;
		СтрокаТЧ.СуммаСНДС = Сумма;

		СуммаДокумента = СуммаДокумента + Сумма;

	КонецЦикла;

	ДокОбъект.СуммаДокумента = СуммаДокумента;

	Возврат ДокОбъект;

КонецФункции

// Головной контрагент партнёра. Приоритет — не обособленному подразделению,
// как в выгрузке клиентов. Пустой результат допустим: заказ проведётся и
// без контрагента, если у партнёра его нет.
Функция ГоловнойКонтрагент(Знач Партнер)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Партнер = &Партнер
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.ОбособленноеПодразделение";

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Справочники.Контрагенты.ПустаяСсылка());

КонецФункции

// Действующий договор клиента для взаиморасчётов.
//
// В этой базе взаиморасчёты ведутся ПО ДОГОВОРАМ: и заказ, и оплата должны
// ссылаться на договор, иначе долг по заказу и оплата не сойдутся. Договор
// заводится в УТ вручную; если у клиента его нет — приём отклоняется понятным
// текстом (заказ/ПКО без договора создать нельзя). Автосоздание договора не
// делаем: это решение по мастер-данным, при необходимости — отдельным методом.
//
// Берётся действующий договор партнёра в организации агента. Если их несколько
// (в этой базе пока по одному) — последний по дате, при равных датах — по
// ссылке (устойчивый порядок: у договоров дата бывает пустой).
//
// Объект расчётов и валюта берутся из самого договора: объект расчётов договора
// — тот же служебный элемент, на который заказ кладёт долг, а оплата ПКО —
// оплату; так они сходятся. Пустой объект расчётов и валюту, отличную от учётной,
// отклоняем заранее понятным текстом — иначе отказ вылезет уже на проведении.
//
// Возвращаемое значение:
//  Структура - Ссылка (договор), ОбъектРасчетов.
Функция ДействующийДоговор(Знач Партнер, Знач Организация)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Договоры.Ссылка КАК Ссылка,
	|	Договоры.ОбъектРасчетов КАК ОбъектРасчетов,
	|	Договоры.ВалютаВзаиморасчетов КАК Валюта
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Партнер = &Партнер
	|	И Договоры.Организация = &Организация
	|	И Договоры.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровКонтрагентов.Действует)
	|	И НЕ Договоры.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Договоры.Дата УБЫВ,
	|	Договоры.Ссылка";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "У клиента нет действующего договора. Заведите договор в УТ.";
	КонецЕсли;

	Если Выборка.Валюта <> Константы.ВалютаУправленческогоУчета.Получить() Тогда
		ВызватьИсключение "Валюта договора клиента не совпадает с валютой учёта — принять нельзя.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Выборка.ОбъектРасчетов) Тогда
		ВызватьИсключение "По договору клиента не сформирован объект расчётов — принять нельзя.";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Выборка.Ссылка);
	Результат.Вставить("ОбъектРасчетов", Выборка.ОбъектРасчетов);

	Возврат Результат;

КонецФункции

// Основная ставка НДС по стране (в этой базе 12 %). Реализация облагается
// НДС, хотя у номенклатуры может стоять «Без НДС» — так заведены заказы.
Функция ОсновнаяСтавкаНДС()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Страна", Константы.ОсновнаяСтрана.Получить());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтавкиНДС.СтавкаНДС КАК Ставка,
	|	СтавкиНДС.СтавкаНДС.Ставка КАК Процент
	|ИЗ
	|	РегистрСведений.ОсновныеСтавкиНДС.СрезПоследних(, Страна = &Страна) КАК СтавкиНДС";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Не задана основная ставка НДС по стране.";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Ставка", Выборка.Ставка);
	Результат.Вставить("Процент", Выборка.Процент);

	Возврат Результат;

КонецФункции

Функция СборныйКомментарий(Знач Заказ)

	Части = Новый Массив;
	Части.Добавить("SmartSale");

	ДатаОформления = ЗначениеПоля(Заказ, "date");
	Если Не ПустаяСтрока(ДатаОформления) Тогда
		Части.Добавить("оформлен " + ДатаОформления);
	КонецЕсли;

	Комментарий = ЗначениеПоля(Заказ, "comment");
	Если Не ПустаяСтрока(Комментарий) Тогда
		Части.Добавить(Комментарий);
	КонецЕсли;

	Возврат СтрСоединить(Части, "; ");

КонецФункции

// Дата предполагаемой отгрузки заказа. Приходит строкой «гггг-ММ-дд».
// Гарантируем начало дня и «не раньше завтра»: пустую/битую/прошедшую дату
// (телефон такого не пришлёт, но чужой клиент — мог бы) подменяем завтрашним
// днём, чтобы заказ не проваливался и дата была осмысленной.
Функция ДатаОтгрузкиЗаказа(Знач Заказ)

	Завтра = НачалоДня(ТекущаяДатаСеанса()) + 24 * 60 * 60;

	Текст = ЗначениеПоля(Заказ, "delivery_date");
	Если ПустаяСтрока(Текст) Тогда
		Возврат Завтра;
	КонецЕсли;

	ДатаОтгрузки = НачалоДня(ДатаИзСтроки(Текст));
	Возврат ?(ДатаОтгрузки < Завтра, Завтра, ДатаОтгрузки);

КонецФункции

#КонецОбласти

#Область ЖурналПриема

Функция НайтиВЖурнале(Знач Ключ)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Журнал.Принят КАК Принят,
	|	Журнал.Номер КАК Номер,
	|	Журнал.Ошибка КАК Ошибка
	|ИЗ
	|	РегистрСведений.SmartSale_ЖурналПриема КАК Журнал
	|ГДЕ
	|	Журнал.КлючИдемпотентности = &Ключ";

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка, Неопределено);

КонецФункции

Процедура ЗаписатьВЖурнал(Знач Ключ, Знач Документ, Знач Принят, Знач Ошибка)

	Запись = РегистрыСведений.SmartSale_ЖурналПриема.СоздатьМенеджерЗаписи();
	Запись.КлючИдемпотентности = Ключ;
	Запись.Документ = ?(Документ = Неопределено, Документы.ЗаказКлиента.ПустаяСсылка(), Документ);
	Запись.Принят = Принят;
	Запись.Номер = ?(Документ = Неопределено, "",
		ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Номер"), Истина, Истина));
	Запись.Ошибка = Лев(Ошибка, 1000);
	Запись.ДатаПриема = ТекущаяДатаСеанса();
	Запись.Записать();

КонецПроцедуры

// Данные журнала по набору ключей за один запрос плюс актуальные статус и
// пометка удаления заказов: статус мог измениться в УТ после приёма.
Функция ЗаписиЖурнала(Знач Ключи)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ключи", Ключи);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.КлючИдемпотентности КАК Ключ,
	|	Журнал.Принят КАК Принят,
	|	Журнал.Номер КАК Номер,
	|	Журнал.Ошибка КАК Ошибка,
	|	Журнал.Документ КАК Документ,
	|	ВЫРАЗИТЬ(Журнал.Документ КАК Документ.ЗаказКлиента).Статус КАК Статус,
	|	ВЫРАЗИТЬ(Журнал.Документ КАК Документ.ЗаказКлиента).ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	РегистрСведений.SmartSale_ЖурналПриема КАК Журнал
	|ГДЕ
	|	Журнал.КлючИдемпотентности В (&Ключи)";

	ПоКлючу = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Запись = Новый Структура;
		Запись.Вставить("Принят", Выборка.Принят);
		Запись.Вставить("Номер", Выборка.Номер);
		Запись.Вставить("Ошибка", Выборка.Ошибка);
		Запись.Вставить("Состояние", ?(Выборка.Статус = NULL, "", Строка(Выборка.Статус)));
		Запись.Вставить("Отменен", Выборка.ПометкаУдаления = Истина);
		ПоКлючу.Вставить(Выборка.Ключ, Запись);
	КонецЦикла;

	Возврат ПоКлючу;

КонецФункции

Процедура ЗаписатьОшибкуВЖР(Знач Ключ, Знач Метка, Знач ИнфОшибки, Знач Сообщения = "")

	Попытка
		Текст = "trace_id " + Метка + ", client_uid " + Ключ + ": "
			+ ПодробноеПредставлениеОшибки(ИнфОшибки);
		Если Не ПустаяСтрока(Сообщения) Тогда
			Текст = Текст + Символы.ПС + "Сообщения проведения:" + Символы.ПС + Сообщения;
		КонецЕсли;
		ЗаписьЖурналаРегистрации("SmartSale.ПриемЗаказов",
			УровеньЖурналаРегистрации.Ошибка, , , Текст);
	Исключение
		// Журнал регистрации недоступен — ответить клиенту всё равно нужно.
	КонецПопытки;

КонецПроцедуры

// Сообщения пользователю, накопленные при проведении. Именно в них 1С
// кладёт конкретную причину отказа («не заполнено…», контроль остатков),
// тогда как исключение несёт лишь «Не удалось провести».
Функция СобратьСообщенияПользователю()

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;

	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СсылкаПоУИД(Знач Менеджер, Знач Значение, Знач ИмяПоля)

	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "Не заполнено поле «" + ИмяПоля + "».";
	КонецЕсли;

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Значение);
	Исключение
		ВызватьИсключение "Поле «" + ИмяПоля + "» не является идентификатором.";
	КонецПопытки;

	Ссылка = Менеджер.ПолучитьСсылку(Идентификатор);

	Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		ВызватьИсключение "Поле «" + ИмяПоля + "» указывает на несуществующий объект.";
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

Функция ЗначениеПоля(Знач Источник, Знач Имя)

	Значение = Неопределено;
	Если ТипЗнч(Источник) = Тип("Структура") И Источник.Свойство(Имя, Значение)
		И Значение <> Неопределено Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;

	Возврат "";

КонецФункции

// Число из строкового поля JSON. Числа приходят строками, разделитель —
// точка; приводим к запятой, потому что Число() ждёт разделитель локали.
Функция ЧислоИзПоля(Знач Источник, Знач Имя)

	Текст = ЗначениеПоля(Источник, Имя);
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	// Убираем обычный и неразрывный (160) пробелы: если клиент нарушит
	// контракт и пришлёт число JSON-числом, Строка() от него в этой локали
	// разделяет разряды неразрывным пробелом.
	Очищенное = СтрЗаменить(Текст, " ", "");
	Очищенное = СтрЗаменить(Очищенное, Символ(160), "");
	Очищенное = СтрЗаменить(Очищенное, ".", ",");

	ОписаниеЧисла = Новый ОписаниеТипов("Число",
		Новый КвалификаторыЧисла(18, 3, ДопустимыйЗнак.Любой));

	Возврат ОписаниеЧисла.ПривестиЗначение(Очищенное);

КонецФункции

Функция ВремяСервера()

	Возврат Формат(УниверсальноеВремя(ТекущаяДатаСеанса()),
		"ДФ=""гггг-ММ-ддTЧЧ:мм:сс""") + "Z";

КонецФункции

// Ссылка на задание по uid без исключения: нет/битый uid → Неопределено.
// Нужна фотоприёму, чтобы отличить постоянный отказ (нет задания) от сбоя
// хранения и не гонять «мёртвое» фото по кругу.
Функция ЗаданиеПоУИД(Знач УИД)

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(УИД);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Ссылка = Справочники.SmartSale_Задания.ПолучитьСсылку(Идентификатор);
	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Есть ли уже у клиента приложенный файл с таким именем — защита от повторной
// доставки одного снимка.
//
// Привилегированный режим — тот же, под которым файл ПИШЕТСЯ (учётке обмена
// прав на присоединённые файлы не выдано). Иначе проверка идемпотентности шла
// бы под другими правами, чем запись: при нехватке прав чтения запрос без
// РАЗРЕШЕННЫЕ бросил бы «Недостаточно прав» → первое же фото зациклилось бы, ни
// разу не приложившись; а под РАЗРЕШЕННЫЕ дедуп молча промахивался бы и повтор
// после потерянного ответа создавал дубль. Режим сбрасывается на выходе.
Функция ФайлКлиентаСуществует(Знач Клиент, Знач ИмяФайла)

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Имя", ИмяФайла);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Файлы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПартнерыПрисоединенныеФайлы КАК Файлы
	|ГДЕ
	|	Файлы.ВладелецФайла = &Клиент
	|	И Файлы.Наименование = &Имя";

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Описание файла — ссылка на задание, чтобы фото было опознаваемо в общем
// списке файлов клиента.
Функция ОписаниеЗадания(Знач Задание)

	Текст = СокрЛП(Задание.Текст);
	Описание = "Задание";
	Если ЗначениеЗаполнено(Задание.Дата) Тогда
		Описание = Описание + " от " + Формат(Задание.Дата, "ДЛФ=D");
	КонецЕсли;
	Если Не ПустаяСтрока(Текст) Тогда
		Описание = Описание + ": " + Текст;
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Приложить фото к клиенту через штатный механизм БСП. Привилегированный режим:
// сервисной учётке обмена права на добавление присоединённых файлов и запись в
// том не выдаём — режим сбрасывается платформой на выходе из процедуры.
Процедура ПриложитьФотоКлиенту(Знач Клиент, Знач ИмяФайла, Знач ДвоичныеДанные,
	Знач Описание)

	УстановитьПривилегированныйРежим(Истина);

	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов = Клиент;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайла;
	ПараметрыФайла.РасширениеБезТочки = "jpg";
	ПараметрыФайла.ВремяИзмененияУниверсальное = ТекущаяУниверсальнаяДата();

	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
	ПрисоединенныйФайл = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Адрес);

	// Описание ставим на созданном файле, а не через параметры добавления:
	// состав структуры параметров зависит от версии БСП, а реквизит «Описание»
	// у присоединённого файла есть всегда. Это подпись файла в списке клиента.
	Если Не ПустаяСтрока(Описание) Тогда
		ФайлОбъект = ПрисоединенныйФайл.ПолучитьОбъект();
		ФайлОбъект.Описание = Описание;
		ФайлОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

// Обновить координаты одного клиента. Пустая широта/долгота не трогается —
// чтобы уточнение одной оси не стёрло другую.
Функция ОбновитьКоординатыОдну(Знач Запись)

	Результат = Новый Структура;
	Результат.Вставить("customer_uid", ЗначениеПоля(Запись, "customer_uid"));
	Результат.Вставить("status", "rejected");
	Результат.Вставить("error", "");

	УИД = ЗначениеПоля(Запись, "customer_uid");
	Если ПустаяСтрока(УИД) Тогда
		Результат.error = "Не заполнен customer_uid.";
		Возврат Результат;
	КонецЕсли;

	Широта = ЗначениеПоля(Запись, "lat");
	Долгота = ЗначениеПоля(Запись, "lon");
	Если ПустаяСтрока(Широта) И ПустаяСтрока(Долгота) Тогда
		Результат.error = "Не заданы координаты.";
		Возврат Результат;
	КонецЕсли;

	Партнер = СсылкаПоУИД(Справочники.Партнеры, УИД, "customer_uid");
	Контрагент = ГоловнойКонтрагент(Партнер);
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Результат.error = "У клиента нет контрагента — координаты писать некуда.";
		Возврат Результат;
	КонецЕсли;

	ЗаписатьКоординаты(Контрагент, Широта, Долгота);

	Результат.status = "accepted";
	Возврат Результат;

КонецФункции

// Запись географических координат в контактную информацию контрагента. Виды КИ
// берём те же, что читает выгрузка (по факту используемые на контрагентах), —
// чтобы уточнённая точка встала ровно туда, откуда /customers её потом читает.
Процедура ЗаписатьКоординаты(Знач Контрагент, Знач Широта, Знач Долгота)

	ВидШироты = ВидКоординаты("ГеографическаяШирота");
	ВидДолготы = ВидКоординаты("ГеографическаяДолгота");
	Если ВидШироты = Неопределено Или ВидДолготы = Неопределено Тогда
		ВызватьИсключение "В базе не заведены виды координат контрагента.";
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	КонтрагентОбъект = Контрагент.ПолучитьОбъект();
	Если Не ПустаяСтрока(Широта) Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(
			КонтрагентОбъект, Широта, ВидШироты, , Истина);
	КонецЕсли;
	Если Не ПустаяСтрока(Долгота) Тогда
		УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(
			КонтрагентОбъект, Долгота, ВидДолготы, , Истина);
	КонецЕсли;
	КонтрагентОбъект.Записать();

КонецПроцедуры

// Вид контактной информации по идентификатору для формул, из фактически
// используемых на контрагентах (у одного идентификатора могут быть свои виды в
// разных наборах — берём тот, что реально стоит на контрагентах).
Функция ВидКоординаты(Знач Идентификатор)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КИ.Вид КАК Вид
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|ГДЕ
	|	КИ.Вид.ИдентификаторДляФормул = &Идентификатор";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Вид;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Записать один аудит в регистр набором по КлючАудита с замещением (повтор
// доставки перезаписывает строки аудита). Привилегированный режим: прав на
// регистр учётке обмена не выдаём, сбрасывается платформой на выходе.
Функция ЗаписатьАудит(Знач Аудит)

	КлючАудита = ЗначениеПоля(Аудит, "client_uid");
	Если ПустаяСтрока(КлючАудита) Тогда
		ВызватьИсключение "Не заполнен client_uid аудита.";
	КонецЕсли;
	Если Не Аудит.Свойство("answers") Или ТипЗнч(Аудит.answers) <> Тип("Массив") Тогда
		ВызватьИсключение "В аудите нет массива «answers».";
	КонецЕсли;

	Клиент = СсылкаПоУИД(Справочники.Партнеры,
		ЗначениеПоля(Аудит, "customer_uid"), "customer_uid");
	Агент = АгентПоУИД(ЗначениеПоля(Аудит, "agent_uid"));
	ДатаАудита = ДатаИзСтроки(ЗначениеПоля(Аудит, "date"));

	УстановитьПривилегированныйРежим(Истина);

	Набор = РегистрыСведений.SmartSale_РезультатыАудита.СоздатьНаборЗаписей();
	Набор.Отбор.КлючАудита.Установить(КлючАудита);
	ВиденныеВопросы = Новый Соответствие;
	Для Каждого Ответ Из Аудит.answers Цикл
		УИДВопроса = ЗначениеПоля(Ответ, "question_uid");
		Если ПустаяСтрока(УИДВопроса) Тогда
			Продолжить;
		КонецЕсли;
		// Удалённый в УТ вопрос пропускаем, а не роняем весь аудит: один
		// устаревший вопрос не должен терять остальные ответы. (Деактивация
		// вопроса ссылку не рушит — только физическое удаление.)
		Вопрос = ВопросАудитаПоУИД(УИДВопроса);
		Если Вопрос = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Защита от повтора одного вопроса в пакете: дубль ключа набора
		// (КлючАудита + Вопрос) иначе уронил бы запись.
		Если ВиденныеВопросы[Вопрос] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ВиденныеВопросы.Вставить(Вопрос, Истина);
		Запись = Набор.Добавить();
		Запись.КлючАудита = КлючАудита;
		Запись.Вопрос = Вопрос;
		Запись.Ответ = ЗначениеПоля(Ответ, "value");
		Запись.Клиент = Клиент;
		Запись.Агент = Агент;
		Запись.Дата = ДатаАудита;
	КонецЦикла;
	Набор.Записать(Истина);

	Результат = Новый Структура;
	Результат.Вставить("client_uid", КлючАудита);
	Результат.Вставить("status", "accepted");
	Результат.Вставить("error", "");
	Возврат Результат;

КонецФункции

// Пользователь-агент по uid без исключения: нет/битый/несуществующий → пустая
// ссылка (агент в аудите необязателен).
Функция АгентПоУИД(Знач УИД)

	Если ПустаяСтрока(УИД) Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(УИД);
	Исключение
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецПопытки;

	Ссылка = Справочники.Пользователи.ПолучитьСсылку(Идентификатор);
	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

// Вопрос аудита по uid без исключения: нет/битый/удалённый → Неопределено
// (такой ответ пропускается, остальные пишутся).
Функция ВопросАудитаПоУИД(Знач УИД)

	Попытка
		Идентификатор = Новый УникальныйИдентификатор(УИД);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Ссылка = Справочники.SmartSale_ВопросыАудита.ПолучитьСсылку(Идентификатор);
	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Приоритет заказа по умолчанию — «Средний». Предопределённых приоритетов в
// базе нет, поэтому ищем по наименованию; нет «Среднего» — берём любой
// непомеченный (лишь бы поле было заполнено для ручного перепроведения).
Функция ПриоритетПоУмолчанию()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СпрПриоритеты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Приоритеты КАК СпрПриоритеты
	|ГДЕ
	|	НЕ СпрПриоритеты.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА СпрПриоритеты.Наименование = ""Средний""
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Приоритеты.ПустаяСсылка();

КонецФункции

// Запасной вид цены — когда у партнёра он не задан. Любой непомеченный: нужен
// лишь для того, чтобы строка заказа считалась «по цене», конкретный вид на
// контроль сумм не влияет.
Функция ВидЦеныПоУмолчанию()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СпрВидыЦен.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыЦен КАК СпрВидыЦен
	|ГДЕ
	|	НЕ СпрВидыЦен.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ВидыЦен.ПустаяСсылка();

КонецФункции

// Дата из строки «гггг-ММ-дд» или «гггг-ММ-ддTЧЧ:мм:сс». Пустая/битая →
// текущая дата сеанса (аудит без валидной даты лучше принять с «сейчас», чем
// потерять).
Функция ДатаИзСтроки(Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;

	Попытка
		ГодЗначение = Число(Сред(Текст, 1, 4));
		МесяцЗначение = Число(Сред(Текст, 6, 2));
		ДеньЗначение = Число(Сред(Текст, 9, 2));
		ЧасЗначение = 0;
		МинутаЗначение = 0;
		СекундаЗначение = 0;
		Если СтрДлина(Текст) >= 19 Тогда
			ЧасЗначение = Число(Сред(Текст, 12, 2));
			МинутаЗначение = Число(Сред(Текст, 15, 2));
			СекундаЗначение = Число(Сред(Текст, 18, 2));
		КонецЕсли;
		Возврат Дата(ГодЗначение, МесяцЗначение, ДеньЗначение,
			ЧасЗначение, МинутаЗначение, СекундаЗначение);
	Исключение
		Возврат ТекущаяДатаСеанса();
	КонецПопытки;

КонецФункции

#КонецОбласти
