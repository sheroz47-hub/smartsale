// Модуль управляемой формы внешней обработки «SmartSale: QR-подключение».
//
// АРМ для онбординга агента: показывает QR-код с адресом сервера, логином и
// паролем агента (из регистра SmartSale_СкладыАгентов). Агент сканирует QR в
// приложении и входит автоматически, не набирая учётные данные руками.
//
// Компромисс безопасности: пароль попадает в QR открытым текстом (как и сейчас
// он идёт УТ→сервер открытым текстом). QR показывается разово, на месте, на
// телефон агента. Разовый токен привязки — усиление на будущее.
//
// QR штатный (БСП УправлениеПечатью.ДанныеQRКода). Сервер и объекты УТ НЕ
// меняются — телефон использует существующий вход /auth/login.
//
// Реквизиты формы (см. README):
//   Агент        - СправочникСсылка.Пользователи
//   АдресСервера - Строка (URL сервера SmartSale)
//   Логин        - Строка (ТолькоПросмотр, показывается после генерации)
//   QRКартинка   - Строка (адрес картинки во временном хранилище, PictureField)
//   Лог          - Строка (ТолькоПросмотр)

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресСервера = "https://smartsale.31.207.45.93.sslip.io";

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьQR(Команда)

	Если НЕ ЗначениеЗаполнено(Агент) Тогда
		ПоказатьПредупреждение(, "Укажите агента.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СокрЛП(АдресСервера)) Тогда
		ПоказатьПредупреждение(, "Укажите адрес сервера.");
		Возврат;
	КонецЕсли;
	СформироватьQRНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаСервере
Процедура СформироватьQRНаСервере()

	QRКартинка = "";
	Логин = "";

	УчетнаяЗапись = УчетнаяЗаписьАгента(Агент);
	Если УчетнаяЗапись = Неопределено Тогда
		Лог = "У агента нет строки в регистре SmartSale_СкладыАгентов —"
			+ " негде взять логин/пароль. Заведите учётку агента.";
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(УчетнаяЗапись.Логин) Тогда
		Лог = "У агента не заполнен логин в SmartSale_СкладыАгентов.";
		Возврат;
	КонецЕсли;

	Данные = Новый Структура;
	Данные.Вставить("url", СокрЛП(АдресСервера));
	Данные.Вставить("login", СокрЛП(УчетнаяЗапись.Логин));
	Данные.Вставить("password", УчетнаяЗапись.Пароль);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	СтрокаQR = Запись.Закрыть();

	ДанныеQR = УправлениеПечатью.ДанныеQRКода(СтрокаQR, 0, 190);
	Если ТипЗнч(ДанныеQR) <> Тип("ДвоичныеДанные") Тогда
		Лог = "Не удалось сгенерировать QR (проверьте компоненту генерации ШК).";
		Возврат;
	КонецЕсли;

	QRКартинка = ПоместитьВоВременноеХранилище(Новый Картинка(ДанныеQR), УникальныйИдентификатор);
	Логин = СокрЛП(УчетнаяЗапись.Логин);
	Лог = "QR готов для агента «" + Строка(Агент) + "» (логин " + Логин + ")."
		+ " Пусть агент отсканирует его в приложении — вход выполнится автоматически.";

КонецПроцедуры

&НаСервереБезКонтекста
Функция УчетнаяЗаписьАгента(Знач Агент)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Логин КАК Логин,
	|	Склады.Пароль КАК Пароль
	|ИЗ
	|	РегистрСведений.SmartSale_СкладыАгентов КАК Склады
	|ГДЕ
	|	Склады.Пользователь = &Агент";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура("Логин, Пароль", Выборка.Логин, Выборка.Пароль);
		Возврат Результат;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
