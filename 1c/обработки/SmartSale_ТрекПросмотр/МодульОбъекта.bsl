// Внешняя обработка «SmartSale: просмотр трека».
// Показывает фактический путь агента за период (регистр SmartSale_ТрекАгента)
// и время у клиентов. Логика — в модуле формы. Здесь — сведения для регистрации
// дополнительной обработки в базе.

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("Наименование", "SmartSale: просмотр трека");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Фактический путь агента за период и время у клиентов по треку.");

	ТаблицаКоманд = Новый ТаблицаЗначений;
	ТаблицаКоманд.Колонки.Добавить("Представление");
	ТаблицаКоманд.Колонки.Добавить("Идентификатор");
	ТаблицаКоманд.Колонки.Добавить("Использование");
	ТаблицаКоманд.Колонки.Добавить("ПоказыватьОповещение");
	ТаблицаКоманд.Колонки.Добавить("Модификатор");

	СтрокаКоманды = ТаблицаКоманд.Добавить();
	СтрокаКоманды.Представление = "SmartSale: просмотр трека";
	СтрокаКоманды.Идентификатор = "ОткрытьФорму";
	СтрокаКоманды.Использование = "ОткрытиеФормы";
	СтрокаКоманды.ПоказыватьОповещение = Ложь;

	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти
