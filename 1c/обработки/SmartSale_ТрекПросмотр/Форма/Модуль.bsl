// Модуль управляемой формы внешней обработки «SmartSale: просмотр трека».
//
// АРМ супервайзера: показывает ФАКТИЧЕСКИЙ путь агента за период по точкам трека
// (регистр SmartSale_ТрекАгента, куда их кладёт обмен) и считает, сколько агент
// пробыл у каждого клиента. Путь и время у клиентов считает JS страницы
// (близость точек трека к координатам клиентов, радиус 100 м) — на сервере
// только выборка и вывод в HTML, без гео-математики в BSL и без моста 1С↔JS.
//
// Карта — Поле HTML-документа с Leaflet (CDN) и тайлами OpenStreetMap. Требует
// интернета на рабочем месте и ТОНКОГО клиента.
//
// Реквизиты формы (см. README):
//   Агент       - СправочникСсылка.Пользователи
//   ДатаС       - Дата (состав «Дата»)
//   ДатаПо      - Дата (состав «Дата»)
//   ПолеБраузер - Строка (HTML, HTMLDocumentField)
//   Лог         - Строка (ТолькоПросмотр)

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаС = НачалоДня(ТекущаяДатаСеанса());
	ДатаПо = НачалоДня(ТекущаяДатаСеанса());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Показать(Команда)

	Если НЕ ЗначениеЗаполнено(Агент) Тогда
		ПоказатьПредупреждение(, "Укажите агента.");
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаС) И ЗначениеЗаполнено(ДатаПо) И ДатаС > ДатаПо Тогда
		ПоказатьПредупреждение(, "Дата «с» больше даты «по».");
		Возврат;
	КонецЕсли;
	ПоказатьНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаСервере
Процедура ПоказатьНаСервере()

	НачалоПериода = ?(ЗначениеЗаполнено(ДатаС), НачалоДня(ДатаС), Дата(2000, 1, 1));
	КонецПериода = ?(ЗначениеЗаполнено(ДатаПо), КонецДня(ДатаПо), Дата(3999, 12, 31));

	Данные = Новый Структура;
	Данные.Вставить("track", ТочкиТрека(НачалоПериода, КонецПериода));
	Данные.Вставить("clients", КлиентыАгента());

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ДанныеJSON = Запись.Закрыть();

	ПолеБраузер = HTMLТрека(ДанныеJSON);
	Лог = "Точек трека: " + Данные.track.Количество()
		+ ", клиентов с координатами: " + Данные.clients.Количество() + "."
		+ ?(Данные.track.Количество() = 0,
			" За период трека нет — проверьте, включён ли он у агента и прошёл ли обмен.", "");

КонецПроцедуры

&НаСервере
Функция ТочкиТрека(Знач НачалоПериода, Знач КонецПериода)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Период КАК Период,
	|	Т.Широта КАК Широта,
	|	Т.Долгота КАК Долгота
	|ИЗ
	|	РегистрСведений.SmartSale_ТрекАгента КАК Т
	|ГДЕ
	|	Т.Пользователь = &Агент
	|	И Т.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|УПОРЯДОЧИТЬ ПО
	|	Т.Период";

	База = Дата(2000, 1, 1);
	Точки = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Широта) Или ПустаяСтрока(Выборка.Долгота) Тогда
			Продолжить;
		КонецЕсли;
		Точка = Новый Структура;
		Точка.Вставить("lat", СокрЛП(Выборка.Широта));
		Точка.Вставить("lon", СокрЛП(Выборка.Долгота));
		// t — секунды от общей базы (для расчёта длительности в JS),
		// ts — человекочитаемое время для таблицы.
		Точка.Вставить("t", Выборка.Период - База);
		Точка.Вставить("ts", Формат(Выборка.Период, "ДФ=dd.MM HH:mm"));
		Точки.Добавить(Точка);
	КонецЦикла;

	Возврат Точки;

КонецФункции

&НаСервере
Функция КлиентыАгента()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Наименование КАК Наименование,
	|	МАКСИМУМ(ВЫБОР КОГДА КИ.Вид.ИдентификаторДляФормул = ""ГеографическаяШирота""
	|			ТОГДА КИ.Представление ИНАЧЕ """" КОНЕЦ) КАК Широта,
	|	МАКСИМУМ(ВЫБОР КОГДА КИ.Вид.ИдентификаторДляФормул = ""ГеографическаяДолгота""
	|			ТОГДА КИ.Представление ИНАЧЕ """" КОНЕЦ) КАК Долгота
	|ИЗ
	|	Справочник.Партнеры КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|		ПО КИ.Ссылка.Партнер = П.Ссылка
	|			И КИ.Вид.ИдентификаторДляФормул В (""ГеографическаяШирота"", ""ГеографическаяДолгота"")
	|ГДЕ
	|	П.Клиент
	|	И НЕ П.ПометкаУдаления
	|	И П.ОсновнойМенеджер = &Агент
	|СГРУППИРОВАТЬ ПО
	|	П.Ссылка,
	|	П.Наименование";

	Клиенты = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.Широта) Или ПустаяСтрока(Выборка.Долгота) Тогда
			Продолжить;
		КонецЕсли;
		Клиент = Новый Структура;
		Клиент.Вставить("lat", СокрЛП(Выборка.Широта));
		Клиент.Вставить("lon", СокрЛП(Выборка.Долгота));
		Клиент.Вставить("name", Выборка.Наименование);
		Клиенты.Добавить(Клиент);
	КонецЦикла;

	Возврат Клиенты;

КонецФункции

// HTML-страница: карта с треком (линия пути + точки), маркеры клиентов и
// таблица «у кого сколько пробыл». Всё считает JS: длину пути, ближайшего
// клиента (радиус 100 м) и длительность визитов по последовательным точкам.
&НаСервереБезКонтекста
Функция HTMLТрека(Знач ДанныеJSON)

	HTML = "<!DOCTYPE html>
	|<html><head><meta charset=""utf-8"">
	|<link rel=""stylesheet"" href=""https://unpkg.com/leaflet@1.9.4/dist/leaflet.css""/>
	|<script src=""https://unpkg.com/leaflet@1.9.4/dist/leaflet.js""></script>
	|<style>
	|html,body{height:100%;margin:0;padding:0}
	|#map{height:62%}
	|#log{height:38%;overflow:auto;font:12px Arial,sans-serif;padding:6px;
	|  box-sizing:border-box}
	|#log table{border-collapse:collapse;width:100%}
	|#log th,#log td{border:1px solid #ddd;padding:3px 6px;text-align:left}
	|#log th{background:#f2f2f2}
	|#log .sum{margin:4px 0;color:#333}
	|</style>
	|</head><body>
	|<div id=""map""></div>
	|<div id=""log"">Выберите агента и период, затем «Показать».</div>
	|<script>
	|var data = %ДАННЫЕ%;
	|var RADIUS = 100;
	|var map = L.map('map').setView([41.311,69.240],11);
	|L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,
	|  attribution:'© OpenStreetMap'}).addTo(map);
	|function num(x){ return parseFloat(x); }
	|function dist(la1,lo1,la2,lo2){
	|  var R=6371000, rad=Math.PI/180;
	|  var dLa=(la2-la1)*rad, dLo=(lo2-lo1)*rad;
	|  var s=Math.sin(dLa/2)*Math.sin(dLa/2)+Math.cos(la1*rad)*Math.cos(la2*rad)*
	|    Math.sin(dLo/2)*Math.sin(dLo/2);
	|  return 2*R*Math.asin(Math.sqrt(s));
	|}
	|var tr=[], all=[];
	|data.track.forEach(function(p){
	|  var la=num(p.lat), lo=num(p.lon);
	|  if(isNaN(la)||isNaN(lo)) return;
	|  tr.push({la:la,lo:lo,t:p.t,ts:p.ts}); all.push([la,lo]);
	|});
	|var cl=[];
	|data.clients.forEach(function(c){
	|  var la=num(c.lat), lo=num(c.lon);
	|  if(isNaN(la)||isNaN(lo)) return;
	|  cl.push({name:c.name,la:la,lo:lo}); all.push([la,lo]);
	|  L.circleMarker([la,lo],{radius:6,color:'#c0392b',weight:2,fillColor:'#e74c3c',
	|    fillOpacity:0.5}).addTo(map).bindTooltip(c.name);
	|});
	|// линия пути
	|var path=tr.map(function(p){return [p.la,p.lo];});
	|var пройдено=0;
	|for(var i=1;i<path.length;i++){ пройдено+=dist(tr[i-1].la,tr[i-1].lo,tr[i].la,tr[i].lo); }
	|if(path.length>1){ L.polyline(path,{color:'#2c6fbb',weight:3,opacity:0.85}).addTo(map); }
	|// старт/финиш
	|if(tr.length){
	|  L.circleMarker([tr[0].la,tr[0].lo],{radius:6,color:'#27ae60',weight:2,
	|    fillColor:'#2ecc71',fillOpacity:0.9}).addTo(map).bindTooltip('Старт '+tr[0].ts);
	|  var e=tr[tr.length-1];
	|  L.circleMarker([e.la,e.lo],{radius:6,color:'#8e44ad',weight:2,
	|    fillColor:'#9b59b6',fillOpacity:0.9}).addTo(map).bindTooltip('Финиш '+e.ts);
	|}
	|// ближайший клиент к точке (в пределах радиуса)
	|function nearest(pt){
	|  var best=null, bd=RADIUS;
	|  for(var k=0;k<cl.length;k++){
	|    var d=dist(pt.la,pt.lo,cl[k].la,cl[k].lo);
	|    if(d<bd){ bd=d; best=cl[k]; }
	|  }
	|  return best;
	|}
	|// визиты: подряд идущие точки у одного клиента = один визит
	|var visits=[], cur=null;
	|tr.forEach(function(pt){
	|  var n=nearest(pt);
	|  if(n){
	|    if(cur && cur.c===n){ cur.end=pt; }
	|    else { if(cur) visits.push(cur); cur={c:n,start:pt,end:pt}; }
	|  } else { if(cur){ visits.push(cur); cur=null; } }
	|});
	|if(cur) visits.push(cur);
	|// таблица
	|var rows='';
	|visits.forEach(function(v){
	|  var mins=Math.round((v.end.t-v.start.t)/60);
	|  rows+='<tr><td>'+v.c.name+'</td><td>'+v.start.ts+'</td><td>'+v.end.ts+
	|    '</td><td>'+mins+'</td></tr>';
	|});
	|var log=document.getElementById('log');
	|log.innerHTML =
	|  '<div class=""sum"">Точек трека: <b>'+tr.length+'</b>, пройдено ~<b>'+
	|  (пройдено/1000).toFixed(1)+' км</b>, визитов у клиентов: <b>'+visits.length+
	|  '</b> <small>(радиус 100 м)</small></div>' +
	|  (visits.length ?
	|    '<table><tr><th>Клиент</th><th>Приход</th><th>Уход</th><th>Мин</th></tr>'+
	|      rows+'</table>' :
	|    '<div class=""sum"">Совпадений с клиентами не найдено.</div>');
	|function fitAll(tries){
	|  if(!all.length) return;
	|  map.invalidateSize();
	|  if(map.getSize().x>0){
	|    map.fitBounds(L.latLngBounds(all).pad(0.2));
	|  } else if(tries>0){
	|    setTimeout(function(){ fitAll(tries-1); },150);
	|  }
	|}
	|fitAll(40);
	|</script></body></html>";

	Возврат СтрЗаменить(HTML, "%ДАННЫЕ%", ДанныеJSON);

КонецФункции

#КонецОбласти
