// Модуль управляемой формы внешней обработки «SmartSale: карта клиентов».
//
// АРМ супервайзера: показывает клиентов выбранного агента на карте (маркеры по
// координатам из контактной информации контрагента — том же источнике, что
// отдаёт /customers и куда пишет уточнение координат с телефона) и позволяет
// собрать МАРШРУТ ОБХОДА и присвоить его агенту на день недели.
//
// Источник порядка — таблица «Маршрут» на форме (добавление из списка клиентов,
// Вверх/Вниз/Удалить). Карта ПОКАЗЫВАЕТ этот порядок (номера + линия), но не
// правит его — двустороннего моста 1С↔JS нет (надёжно, тестируемо). Сохранение
// пишет набор записей в РегистрСведений.SmartSale_Маршруты (Пользователь=агент,
// ДеньНедели, Партнёр, Порядок), замещая прежний маршрут агента на этот день;
// дальше маршрут уходит в приложение штатным обменом.
//
// Карта — Поле HTML-документа с Leaflet (CDN) и тайлами OpenStreetMap. Требует
// интернета на рабочем месте и ТОНКОГО клиента. Навигация по дорогам — по
// ссылкам «Открыть в Яндекс/Google Картах» (Router.dll Моби-С не тащим).
//
// Реквизиты формы (см. README):
//   Агент       - СправочникСсылка.Пользователи
//   ДеньНедели  - Число (1..7, Пн..Вс)
//   ПолеБраузер - Строка (HTML карты, HTMLDocumentField)
//   Лог         - Строка (ТолькоПросмотр)
//   Клиенты     - ТаблицаЗначений: Пометка(Булево), Клиент(Партнеры),
//                 Наименование, Широта, Долгота, ВМаршруте(Булево)
//   Маршрут     - ТаблицаЗначений: Клиент(Партнеры), Наименование, Широта,
//                 Долгота, Номер(Число — позиция, только показ)

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ДеньОбхода.СписокВыбора.Добавить(1, "Понедельник");
	Элементы.ДеньОбхода.СписокВыбора.Добавить(2, "Вторник");
	Элементы.ДеньОбхода.СписокВыбора.Добавить(3, "Среда");
	Элементы.ДеньОбхода.СписокВыбора.Добавить(4, "Четверг");
	Элементы.ДеньОбхода.СписокВыбора.Добавить(5, "Пятница");
	Элементы.ДеньОбхода.СписокВыбора.Добавить(6, "Суббота");
	Элементы.ДеньОбхода.СписокВыбора.Добавить(7, "Воскресенье");
	// Имя реквизита НЕ «ДеньНедели» — оно перекрыло бы встроенную функцию.
	ДеньОбхода = ДеньНедели(ТекущаяДатаСеанса());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)

	Если НЕ ЗначениеЗаполнено(Агент) Тогда
		ПоказатьПредупреждение(, "Укажите агента.");
		Возврат;
	КонецЕсли;
	ЗагрузитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВМаршрут(Команда)

	ДобавитьВМаршрутНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ВверхПоМаршруту(Команда)

	СдвинутьСтроку(-1);

КонецПроцедуры

&НаКлиенте
Процедура ВнизПоМаршруту(Команда)

	СдвинутьСтроку(1);

КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзМаршрута(Команда)

	Идентификатор = Элементы.Маршрут.ТекущаяСтрока;
	Если Идентификатор = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку маршрута.");
		Возврат;
	КонецЕсли;
	УдалитьИзМаршрутаНаСервере(Идентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьМаршрут(Команда)

	ПоказатьМаршрутНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьМаршрут(Команда)

	Если НЕ ЗначениеЗаполнено(Агент) Тогда
		ПоказатьПредупреждение(, "Укажите агента.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДеньОбхода) Тогда
		ПоказатьПредупреждение(, "Укажите день недели.");
		Возврат;
	КонецЕсли;
	Если Маршрут.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Маршрут пуст — добавьте клиентов.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Присвоить маршрут из " + Маршрут.Количество() + " точек агенту "
		+ Строка(Агент) + " на " + ПредставлениеДня(ДеньОбхода)
		+ "? Прежний маршрут на этот день будет заменён.";
	ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьМаршрутЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьМаршрутЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		СохранитьМаршрутНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаКлиенте
Процедура СдвинутьСтроку(Смещение)

	Идентификатор = Элементы.Маршрут.ТекущаяСтрока;
	Если Идентификатор = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите строку маршрута.");
		Возврат;
	КонецЕсли;
	СдвинутьСтрокуНаСервере(Идентификатор, Смещение);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере()

	ЗаполнитьКлиентовАгента();
	ЗагрузитьМаршрутДня();
	ОтметитьВМаршруте();
	ПеренумероватьМаршрут();
	СформироватьКарту();
	Лог = "Клиентов у агента: " + Клиенты.Количество()
		+ ", в маршруте на " + ПредставлениеДня(ДеньОбхода) + ": " + Маршрут.Количество() + ".";

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКлиентовАгента()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Клиент,
	|	П.Наименование КАК Наименование,
	|	МАКСИМУМ(ВЫБОР КОГДА КИ.Вид.ИдентификаторДляФормул = ""ГеографическаяШирота""
	|			ТОГДА КИ.Представление ИНАЧЕ """" КОНЕЦ) КАК Широта,
	|	МАКСИМУМ(ВЫБОР КОГДА КИ.Вид.ИдентификаторДляФормул = ""ГеографическаяДолгота""
	|			ТОГДА КИ.Представление ИНАЧЕ """" КОНЕЦ) КАК Долгота
	|ИЗ
	|	Справочник.Партнеры КАК П
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
	|		ПО КИ.Ссылка.Партнер = П.Ссылка
	|			И КИ.Вид.ИдентификаторДляФормул В (""ГеографическаяШирота"", ""ГеографическаяДолгота"")
	|ГДЕ
	|	П.Клиент
	|	И НЕ П.ПометкаУдаления
	|	И П.ОсновнойМенеджер = &Агент
	|СГРУППИРОВАТЬ ПО
	|	П.Ссылка,
	|	П.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	П.Наименование";

	Клиенты.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаКлиента = Клиенты.Добавить();
		СтрокаКлиента.Пометка = Ложь;
		СтрокаКлиента.Клиент = Выборка.Клиент;
		СтрокаКлиента.Наименование = Выборка.Наименование;
		СтрокаКлиента.Широта = СокрЛП(Выборка.Широта);
		СтрокаКлиента.Долгота = СокрЛП(Выборка.Долгота);
		СтрокаКлиента.ВМаршруте = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьМаршрутДня()

	Маршрут.Очистить();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.УстановитьПараметр("День", ДеньОбхода);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	М.Партнер КАК Клиент,
	|	М.Партнер.Наименование КАК Наименование,
	|	М.Порядок КАК Порядок
	|ИЗ
	|	РегистрСведений.SmartSale_Маршруты КАК М
	|ГДЕ
	|	М.Пользователь = &Агент
	|	И М.ДеньНедели = &День
	|УПОРЯДОЧИТЬ ПО
	|	М.Порядок";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаМаршрута = Маршрут.Добавить();
		СтрокаМаршрута.Клиент = Выборка.Клиент;
		СтрокаМаршрута.Наименование = Выборка.Наименование;
		КоординатыКлиента = КоординатыИзСписка(Выборка.Клиент);
		СтрокаМаршрута.Широта = КоординатыКлиента.Широта;
		СтрокаМаршрута.Долгота = КоординатыКлиента.Долгота;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция КоординатыИзСписка(Знач Клиент)

	Результат = Новый Структура("Широта, Долгота", "", "");
	НайденныеСтроки = Клиенты.НайтиСтроки(Новый Структура("Клиент", Клиент));
	Если НайденныеСтроки.Количество() > 0 Тогда
		Результат.Широта = НайденныеСтроки[0].Широта;
		Результат.Долгота = НайденныеСтроки[0].Долгота;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ДобавитьВМаршрутНаСервере()

	Добавлено = 0;
	Для Каждого СтрокаКлиента Из Клиенты Цикл
		Если НЕ СтрокаКлиента.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаКлиента.ВМаршруте Тогда
			СтрокаКлиента.Пометка = Ложь;
			Продолжить;
		КонецЕсли;
		СтрокаМаршрута = Маршрут.Добавить();
		СтрокаМаршрута.Клиент = СтрокаКлиента.Клиент;
		СтрокаМаршрута.Наименование = СтрокаКлиента.Наименование;
		СтрокаМаршрута.Широта = СтрокаКлиента.Широта;
		СтрокаМаршрута.Долгота = СтрокаКлиента.Долгота;
		СтрокаКлиента.Пометка = Ложь;
		СтрокаКлиента.ВМаршруте = Истина;
		Добавлено = Добавлено + 1;
	КонецЦикла;

	ПеренумероватьМаршрут();
	СформироватьКарту();
	Лог = "Добавлено в маршрут: " + Добавлено + ". Всего точек: " + Маршрут.Количество() + ".";

КонецПроцедуры

&НаСервере
Процедура СдвинутьСтрокуНаСервере(Знач Идентификатор, Знач Смещение)

	СтрокаМаршрута = Маршрут.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаМаршрута = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Индекс = Маршрут.Индекс(СтрокаМаршрута);
	НовыйИндекс = Индекс + Смещение;
	Если НовыйИндекс < 0 Или НовыйИндекс >= Маршрут.Количество() Тогда
		Возврат;
	КонецЕсли;
	Маршрут.Сдвинуть(Индекс, Смещение);
	ПеренумероватьМаршрут();
	СформироватьКарту();
	Элементы.Маршрут.ТекущаяСтрока = Маршрут[НовыйИндекс].ПолучитьИдентификатор();

КонецПроцедуры

&НаСервере
Процедура УдалитьИзМаршрутаНаСервере(Знач Идентификатор)

	СтрокаМаршрута = Маршрут.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаМаршрута = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КлиентУдаляемый = СтрокаМаршрута.Клиент;
	Маршрут.Удалить(Маршрут.Индекс(СтрокаМаршрута));

	СтрокиКлиента = Клиенты.НайтиСтроки(Новый Структура("Клиент", КлиентУдаляемый));
	Для Каждого СтрокаКлиента Из СтрокиКлиента Цикл
		СтрокаКлиента.ВМаршруте = Ложь;
	КонецЦикла;

	ПеренумероватьМаршрут();
	СформироватьКарту();

КонецПроцедуры

&НаСервере
Процедура ПоказатьМаршрутНаСервере()

	СформироватьКарту();
	Лог = "Точек в маршруте: " + Маршрут.Количество() + ".";

КонецПроцедуры

&НаСервере
Процедура СохранитьМаршрутНаСервере()

	Попытка
		НачатьТранзакцию();

		Набор = РегистрыСведений.SmartSale_Маршруты.СоздатьНаборЗаписей();
		Набор.Отбор.Пользователь.Установить(Агент);
		Набор.Отбор.ДеньНедели.Установить(ДеньОбхода);

		Позиция = 0;
		Для Каждого СтрокаМаршрута Из Маршрут Цикл
			Позиция = Позиция + 1;
			Запись = Набор.Добавить();
			Запись.Пользователь = Агент;
			Запись.ДеньНедели = ДеньОбхода;
			Запись.Партнер = СтрокаМаршрута.Клиент;
			Запись.Порядок = Позиция;
		КонецЦикла;

		Набор.Записать(Истина);
		ЗафиксироватьТранзакцию();

		Лог = "Сохранено: маршрут агента " + Строка(Агент) + " на "
			+ ПредставлениеДня(ДеньОбхода) + " — " + Маршрут.Количество()
			+ " точек. Уйдёт в приложение при обмене.";
	Исключение
		ОтменитьТранзакцию();
		Лог = "Ошибка сохранения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура ОтметитьВМаршруте()

	Для Каждого СтрокаКлиента Из Клиенты Цикл
		НайденныеСтроки = Маршрут.НайтиСтроки(Новый Структура("Клиент", СтрокаКлиента.Клиент));
		СтрокаКлиента.ВМаршруте = (НайденныеСтроки.Количество() > 0);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПеренумероватьМаршрут()

	Позиция = 0;
	Для Каждого СтрокаМаршрута Из Маршрут Цикл
		Позиция = Позиция + 1;
		СтрокаМаршрута.Номер = Позиция;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеДня(Знач День)

	Дни = "Понедельник,Вторник,Среда,Четверг,Пятница,Суббота,Воскресенье";
	Если День >= 1 И День <= 7 Тогда
		Возврат СтрРазделить(Дни, ",")[День - 1];
	КонецЕсли;
	Возврат "день " + Строка(День);

КонецФункции

// Клик по маркеру на карте (событие OnClick поля HTML). У каждого маркера id
// вида «sel_<уид клиента>»; по нему отмечаем клиента в таблице «Клиенты агента»
// и подсвечиваем строку — дальше «Добавить в маршрут». Мост HTML→1С работает
// только в тонком клиенте; клики по тайлам/линии (без нашего id) игнорируем.
&НаКлиенте
Процедура ПолеБраузерПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Попытка
		КликнутыйЭлемент = ДанныеСобытия.Button;
	Исключение
		Возврат;
	КонецПопытки;
	Если КликнутыйЭлемент = Неопределено Или КликнутыйЭлемент = NULL Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ИдЭлемента = Строка(КликнутыйЭлемент.id);
	Исключение
		Возврат;
	КонецПопытки;

	Префикс = "sel_";
	Если Не СтрНачинаетсяС(ИдЭлемента, Префикс) Тогда
		Возврат;
	КонецЕсли;
	УИДКлиента = Сред(ИдЭлемента, СтрДлина(Префикс) + 1);

	Для Каждого СтрокаКлиента Из Клиенты Цикл
		Если Строка(СтрокаКлиента.Клиент.УникальныйИдентификатор()) = УИДКлиента Тогда
			СтрокаКлиента.Пометка = НЕ СтрокаКлиента.Пометка;
			Элементы.Клиенты.ТекущаяСтрока = СтрокаКлиента.ПолучитьИдентификатор();
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Точки для карты: все клиенты агента с координатами; у входящих в маршрут —
// поле ord (позиция), у остальных ord = 0 (серый маркер).
&НаСервере
Процедура СформироватьКарту()

	ПорядокПоКлиенту = Новый Соответствие;
	Позиция = 0;
	Для Каждого СтрокаМаршрута Из Маршрут Цикл
		Позиция = Позиция + 1;
		ПорядокПоКлиенту.Вставить(СтрокаМаршрута.Клиент, Позиция);
	КонецЦикла;

	Точки = Новый Массив;
	Для Каждого СтрокаКлиента Из Клиенты Цикл
		Если ПустаяСтрока(СтрокаКлиента.Широта) Или ПустаяСтрока(СтрокаКлиента.Долгота) Тогда
			Продолжить;
		КонецЕсли;
		Точка = Новый Структура;
		Точка.Вставить("lat", СтрокаКлиента.Широта);
		Точка.Вставить("lon", СтрокаКлиента.Долгота);
		Точка.Вставить("name", СтрокаКлиента.Наименование);
		Точка.Вставить("uid", Строка(СтрокаКлиента.Клиент.УникальныйИдентификатор()));
		НомерТочки = ПорядокПоКлиенту.Получить(СтрокаКлиента.Клиент);
		Точка.Вставить("ord", ?(НомерТочки = Неопределено, 0, НомерТочки));
		Точки.Добавить(Точка);
	КонецЦикла;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Точки);
	ТочкиJSON = Запись.Закрыть();

	ПолеБраузер = HTMLКарты(ТочкиJSON);

КонецПроцедуры

// Готовая HTML-страница карты с вшитым массивом точек (порядок из 1С). Leaflet
// и тайлы — из интернета; карта только показывает маршрут, кликами не правит.
&НаСервереБезКонтекста
Функция HTMLКарты(Знач ТочкиJSON)

	HTML = "<!DOCTYPE html>
	|<html><head><meta charset=""utf-8"">
	|<link rel=""stylesheet"" href=""https://unpkg.com/leaflet@1.9.4/dist/leaflet.css""/>
	|<script src=""https://unpkg.com/leaflet@1.9.4/dist/leaflet.js""></script>
	|<style>
	|html,body,#map{height:100%;margin:0;padding:0}
	|.panel{position:absolute;top:8px;right:8px;z-index:1200;background:#fff;
	|  padding:8px 10px;border-radius:6px;box-shadow:0 1px 5px rgba(0,0,0,.35);
	|  font:13px Arial,sans-serif;max-width:240px}
	|.panel b{color:#c0392b}
	|.panel a{display:none;margin-top:6px;color:#2c6fbb;text-decoration:none}
	|.mk{width:14px;height:14px;border-radius:50%;background:#bbb;
	|  border:2px solid #888;box-sizing:border-box;cursor:pointer}
	|.mk.rt{width:auto;height:auto;min-width:16px;border-radius:9px;
	|  background:#c0392b;border:0;color:#fff;font:bold 12px Arial;
	|  text-align:center;padding:1px 6px;line-height:16px;cursor:pointer}
	|</style>
	|</head><body>
	|<div id=""map""></div>
	|<div class=""panel"">
	|  <div id=""info"">Маршрут не задан</div>
	|  <a id=""yandex"" target=""_blank"" rel=""noopener"">Открыть в Яндекс.Картах</a>
	|  <a id=""google"" target=""_blank"" rel=""noopener"">Открыть в Google Картах</a>
	|</div>
	|<script>
	|var pts = %ТОЧКИ%;
	|var map = L.map('map').setView([41.311,69.240],11);
	|L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,
	|  attribution:'© OpenStreetMap'}).addTo(map);
	|var all=[];
	|function dist(a,b){
	|  var R=6371000, rad=Math.PI/180;
	|  var dLa=(b[0]-a[0])*rad, dLo=(b[1]-a[1])*rad;
	|  var s=Math.sin(dLa/2)*Math.sin(dLa/2)+Math.cos(a[0]*rad)*Math.cos(b[0]*rad)*
	|    Math.sin(dLo/2)*Math.sin(dLo/2);
	|  return 2*R*Math.asin(Math.sqrt(s));
	|}
	|pts.forEach(function(p){
	|  var la=parseFloat(p.lat), lo=parseFloat(p.lon);
	|  if(isNaN(la)||isNaN(lo)) return;
	|  if(!(p.ord>0)){
	|    var ic=L.divIcon({className:'',iconSize:[14,14],iconAnchor:[7,7],
	|      html:'<div id=""sel_'+p.uid+'"" class=""mk"" title=""'+p.name+'""></div>'});
	|    L.marker([la,lo],{icon:ic}).addTo(map);
	|    all.push([la,lo]);
	|  }
	|});
	|var route = pts.filter(function(p){return p.ord>0;})
	|  .sort(function(a,b){return a.ord-b.ord;});
	|var coords=[], total=0;
	|route.forEach(function(p){
	|  var la=parseFloat(p.lat), lo=parseFloat(p.lon);
	|  if(isNaN(la)||isNaN(lo)) return;
	|  var ic=L.divIcon({className:'',iconSize:null,
	|    html:'<div id=""sel_'+p.uid+'"" class=""mk rt"" title=""'+p.name+'"">'+p.ord+'</div>'});
	|  L.marker([la,lo],{icon:ic}).addTo(map);
	|  coords.push([la,lo]); all.push([la,lo]);
	|});
	|for(var i=1;i<coords.length;i++){ total+=dist(coords[i-1],coords[i]); }
	|if(coords.length>1){
	|  L.polyline(coords,{color:'#c0392b',weight:4,opacity:0.85}).addTo(map);
	|}
	|var info=document.getElementById('info');
	|info.innerHTML = route.length ?
	|  ('Точек в маршруте: <b>'+route.length+'</b>, длина <b>'+(total/1000).toFixed(1)+
	|    ' км</b><br><small>прямая между точками; по дорогам — по ссылке</small>') :
	|  'Маршрут не задан — добавьте точки в список';
	|var yl=document.getElementById('yandex'), gl=document.getElementById('google');
	|if(route.length>=2){
	|  var seq=route.map(function(p){return p.lat+','+p.lon;});
	|  yl.href='https://yandex.ru/maps/?rtext='+seq.join('~')+'&rtt=auto';
	|  gl.href='https://www.google.com/maps/dir/'+seq.join('/');
	|  yl.style.display='block'; gl.style.display='block';
	|}
	|function fitAll(tries){
	|  if(!all.length) return;
	|  map.invalidateSize();
	|  if(map.getSize().x>0){
	|    map.fitBounds(L.latLngBounds(all).pad(0.2));
	|  } else if(tries>0){
	|    setTimeout(function(){ fitAll(tries-1); },150);
	|  }
	|}
	|fitAll(40);
	|</script></body></html>";

	Возврат СтрЗаменить(HTML, "%ТОЧКИ%", ТочкиJSON);

КонецФункции

#КонецОбласти
