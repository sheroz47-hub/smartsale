// Внешняя обработка «SmartSale: формирование MML».
// Задаёт обязательный ассортимент формата документом ИзменениеАссортимента.
// Логика — в модуле формы. Здесь сведения для регистрации доп.обработки.

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("Наименование", "SmartSale: формирование MML");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Обязательный ассортимент (MML) формата магазина через ИзменениеАссортимента.");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Использование");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Модификатор");

	Команда = Команды.Добавить();
	Команда.Представление = "SmartSale: формирование MML";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;

	ПараметрыРегистрации.Вставить("Команды", Команды);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти
