// Модуль управляемой формы внешней обработки «SmartSale: формирование MML».
//
// АРМ маркетолога/супервайзера: задаёт обязательный ассортимент (must-stock) для
// формата магазина типовым механизмом — документом «ИзменениеАссортимента»,
// который наполняет регистр «Ассортимент». Роль строки «Постоянный ассортимент»
// и есть MML. Один прогон — один документ со всеми отмеченными товарами.
//
// ⚠ Требует включённой опции «Использовать ассортимент» и заведённых форматов
// магазинов (каналов сбыта). Клиент привязывается к формату отдельно.
//
// Реквизиты формы (см. README):
//   Формат            - СправочникСсылка.ФорматыМагазинов
//   Роль              - ПеречислениеСсылка.РолиАссортимента
//   ОтборНоменклатуры - Строка (фильтр по имени)
//   Проводить         - Булево
//   Лог               - Строка (многострочная, ТолькоПросмотр)
//   Товары            - ТаблицаЗначений: Пометка(Булево),
//                       Номенклатура(СправочникСсылка.Номенклатура),
//                       Наименование(Строка), Результат(Строка)

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Роль = Перечисления.РолиАссортимента.ПостоянныйАссортимент;
	Проводить = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьНоменклатуру(Команда)

	ЗаполнитьНоменклатуруНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьПометки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	УстановитьПометки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВАссортимент(Команда)

	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		ПоказатьПредупреждение(, "Укажите формат магазина.");
		Возврат;
	КонецЕсли;

	Отмеченных = 0;
	Для Каждого Строка Из Товары Цикл
		Если Строка.Пометка Тогда
			Отмеченных = Отмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если Отмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одного товара.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Добавить " + Отмеченных + " товаров в ассортимент формата «"
		+ Строка(Формат) + "»?";
	ОписаниеОповещения = Новый ОписаниеОповещения("ДобавитьВАссортиментЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВАссортиментЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ДобавитьВАссортиментНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Значение)

	Для Каждого Строка Из Товары Цикл
		Строка.Пометка = Значение;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНоменклатуруНаСервере()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БезФильтра", НЕ ЗначениеЗаполнено(СокрЛП(ОтборНоменклатуры)));
	Запрос.УстановитьПараметр("Шаблон", "%" + СокрЛП(ОтборНоменклатуры) + "%");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Н.Ссылка КАК Номенклатура,
	|	Н.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И (&БезФильтра ИЛИ Н.Наименование ПОДОБНО &Шаблон)
	|УПОРЯДОЧИТЬ ПО
	|	Н.Наименование";

	Товары.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = Товары.Добавить();
		СтрокаТаблицы.Номенклатура = Выборка.Номенклатура;
		СтрокаТаблицы.Наименование = Выборка.Наименование;
		СтрокаТаблицы.Пометка = Ложь;
		СтрокаТаблицы.Результат = "";
	КонецЦикла;

	Лог = "Найдено товаров: " + Товары.Количество()
		+ ?(Товары.Количество() = 500, " (показаны первые 500 — уточните фильтр)", "");

КонецПроцедуры

&НаСервере
Процедура ДобавитьВАссортиментНаСервере()

	Отмеченные = Новый Массив;
	Для Каждого СтрокаТаблицы Из Товары Цикл
		Если СтрокаТаблицы.Пометка Тогда
			Отмеченные.Добавить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;

	Попытка

		НачатьТранзакцию();

		ДокОбъект = Документы.ИзменениеАссортимента.СоздатьДокумент();
		// Заполнить инициализирует умолчания (стадия, даты) — потом уточняем.
		ДокОбъект.Заполнить(Неопределено);
		ДокОбъект.Дата = ТекущаяДатаСеанса();
		ДокОбъект.ОбъектПланирования = Формат;
		ДокОбъект.Операция = Перечисления.ОперацииИзмененияАссортимента.ИзменениеВАссортименте;
		ДокОбъект.ДатаНачалаДействия = НачалоДня(ТекущаяДатаСеанса());
		ДокОбъект.Ответственный = Пользователи.ТекущийПользователь();

		Для Каждого СтрокаТаблицы Из Отмеченные Цикл
			СтрокаТовара = ДокОбъект.Товары.Добавить();
			СтрокаТовара.Номенклатура = СтрокаТаблицы.Номенклатура;
			СтрокаТовара.РольАссортимента = Роль;
		КонецЦикла;

		Если Проводить Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

		Номер = ДокОбъект.Номер;
		Для Каждого СтрокаТаблицы Из Отмеченные Цикл
			СтрокаТаблицы.Результат = "документ " + Номер;
		КонецЦикла;
		Лог = "Готово. Создан документ «Изменение ассортимента» " + Номер
			+ " с " + Отмеченные.Количество() + " товарами"
			+ ?(Проводить, " (проведён).", " (черновик).");

	Исключение

		ОтменитьТранзакцию();
		ТекстОшибки = КраткаяОшибка();
		Для Каждого СтрокаТаблицы Из Отмеченные Цикл
			СтрокаТаблицы.Результат = "ошибка";
		КонецЦикла;
		Лог = "ОШИБКА — " + ТекстОшибки;

	КонецПопытки;

КонецПроцедуры

&НаСервереБезКонтекста
Функция КраткаяОшибка()

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Если Сообщения.Количество() > 0 Тогда
		Тексты = Новый Массив;
		Для Каждого Сообщение Из Сообщения Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		Возврат СтрСоединить(Тексты, "; ");
	КонецЕсли;

	Инфо = ИнформацияОбОшибке();
	Возврат ?(Инфо = Неопределено, "неизвестная ошибка", КраткоеПредставлениеОшибки(Инфо));

КонецФункции

#КонецОбласти
