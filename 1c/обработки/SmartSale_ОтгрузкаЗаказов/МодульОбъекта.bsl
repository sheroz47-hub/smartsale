// Внешняя обработка «SmartSale: отгрузка заказов».
// Создаёт РеализацияТоваровУслуг на основании выбранных заказов клиентов.
// Вся логика — в модуле формы. Здесь только сведения для (необязательной)
// регистрации в подсистеме дополнительных отчётов и обработок.

#Область ПрограммныйИнтерфейс

// Сведения для регистрации в подсистеме «Дополнительные отчёты и обработки».
// Обработку можно и просто открывать через «Файл → Открыть» — тогда эта
// функция не используется.
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("Наименование", "SmartSale: отгрузка заказов");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация",
		"Создание реализаций товаров и услуг на основании заказов клиентов, "
		+ "оформленных агентами SmartSale.");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Использование");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Модификатор");

	Команда = Команды.Добавить();
	Команда.Представление = "SmartSale: отгрузка заказов";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;

	ПараметрыРегистрации.Вставить("Команды", Команды);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти
