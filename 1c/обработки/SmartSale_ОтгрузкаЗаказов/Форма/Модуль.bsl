// Модуль управляемой формы внешней обработки «SmartSale: отгрузка заказов».
//
// АРМ оператора/склада: по отбору выводит заказы клиентов, оператор отмечает
// нужные и одной кнопкой создаёт РеализацияТоваровУслуг НА ОСНОВАНИИ заказов.
// Заполнение — штатное (РеализацияОбъект.Заполнить(ЗаказКлиента) → типовая
// ОбработкаЗаполнения тянет партнёра, договор, товары, цены). Каждый заказ
// обрабатывается отдельной попыткой: ошибка одного не срывает остальные,
// результат по каждому — в лог.
//
// Реквизиты формы (создать в Конфигураторе, см. README):
//   ДатаНачала, ДатаОкончания        - Дата (состав Дата)
//   Менеджер                          - СправочникСсылка.Пользователи
//   ОтборСтатус                       - ПеречислениеСсылка.СтатусыЗаказовКлиентов
//   ПроводитьСразу                    - Булево
//   УстановитьКОтгрузке               - Булево
//   Лог                               - Строка (многострочная, ТолькоПросмотр)
//   Заказы                            - ТаблицаЗначений с колонками:
//       Пометка   - Булево
//       Заказ     - ДокументСсылка.ЗаказКлиента
//       Номер     - Строка
//       Дата      - Дата
//       Партнер   - СправочникСсылка.Партнеры
//       Менеджер  - СправочникСсылка.Пользователи
//       Сумма     - Число
//       Статус    - ПеречислениеСсылка.СтатусыЗаказовКлиентов
//       Результат - Строка   (заполняется после создания реализаций)

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Период по умолчанию — начало месяца … текущий день.
	ДатаНачала = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	ПроводитьСразу = Истина;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьСписокЗаказов();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьПометки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	УстановитьПометки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализации(Команда)

	Отмеченных = 0;
	Для Каждого Строка Из Заказы Цикл
		Если Строка.Пометка Тогда
			Отмеченных = Отмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если Отмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одного заказа.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Создать реализации по " + Отмеченных + " заказам"
		+ ?(ПроводитьСразу, " и провести?", " (без проведения)?");
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьРеализацииЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализацииЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		СоздатьРеализацииНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Значение)

	Для Каждого Строка Из Заказы Цикл
		Строка.Пометка = Значение;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЗаказов()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("БезОтбораМенеджера", НЕ ЗначениеЗаполнено(Менеджер));
	Запрос.УстановитьПараметр("Менеджер", Менеджер);
	Запрос.УстановитьПараметр("БезОтбораСтатуса", НЕ ЗначениеЗаполнено(ОтборСтатус));
	Запрос.УстановитьПараметр("Статус", ОтборСтатус);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Заказ.Ссылка КАК Заказ,
	|	Заказ.Номер КАК Номер,
	|	Заказ.Дата КАК Дата,
	|	Заказ.Партнер КАК Партнер,
	|	Заказ.Менеджер КАК Менеджер,
	|	Заказ.СуммаДокумента КАК Сумма,
	|	Заказ.Статус КАК Статус
	|ИЗ
	|	Документ.ЗаказКлиента КАК Заказ
	|ГДЕ
	|	Заказ.Проведен
	|	И Заказ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И Заказ.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
	|	И (&БезОтбораМенеджера ИЛИ Заказ.Менеджер = &Менеджер)
	|	И (&БезОтбораСтатуса ИЛИ Заказ.Статус = &Статус)
	|УПОРЯДОЧИТЬ ПО
	|	Заказ.Дата";

	Заказы.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = Заказы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
		СтрокаТаблицы.Пометка = Ложь;
		СтрокаТаблицы.Результат = "";
	КонецЦикла;

	Лог = "Найдено заказов: " + Заказы.Количество();

КонецПроцедуры

&НаСервере
Процедура СоздатьРеализацииНаСервере()

	Создано = 0;
	Ошибок = 0;
	Пропущено = 0;
	СтрокиЛога = Новый Массив;

	Для Каждого СтрокаТаблицы Из Заказы Цикл

		Если НЕ СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		ЗаказСсылка = СтрокаТаблицы.Заказ;
		ПрефиксСтроки = "Заказ " + СтрокаТаблицы.Номер + ": ";

		// Защита от повторной отгрузки: если по заказу уже есть реализация —
		// не создаём вторую, только сообщаем.
		Если РеализацияПоЗаказуСуществует(ЗаказСсылка) Тогда
			СтрокаТаблицы.Результат = "уже отгружен";
			СтрокиЛога.Добавить(ПрефиксСтроки + "пропущен — реализация уже есть");
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Попытка

			НачатьТранзакцию();

			// Опционально переводим заказ в «К отгрузке»: наши заказы приходят
			// «На согласовании», а реализация по заказам ожидает отгрузочный
			// статус. Флаг по умолчанию выключен — включать осознанно.
			Если УстановитьКОтгрузке И ЗаказСсылка.Статус
				<> Перечисления.СтатусыЗаказовКлиентов.КОтгрузке Тогда
				ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
				ЗаказОбъект.Статус = Перечисления.СтатусыЗаказовКлиентов.КОтгрузке;
				ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;

			РеализацияОбъект = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			РеализацияОбъект.Заполнить(ЗаказСсылка);

			Если РеализацияОбъект.Товары.Количество() = 0 Тогда
				ВызватьИсключение "заполнение не дало ни одной строки товаров"
					+ " (проверьте статус заказа и остатки к отгрузке)";
			КонецЕсли;

			Если ПроводитьСразу Тогда
				РеализацияОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				РеализацияОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;

			ЗафиксироватьТранзакцию();

			НомерРеализации = РеализацияОбъект.Номер;
			СтрокаТаблицы.Результат = "реализация " + НомерРеализации;
			СтрокиЛога.Добавить(ПрефиксСтроки + "создана реализация " + НомерРеализации
				+ ?(ПроводитьСразу, " (проведена)", " (черновик)"));
			Создано = Создано + 1;

		Исключение

			ОтменитьТранзакцию();
			ТекстОшибки = КраткаяОшибка();
			СтрокаТаблицы.Результат = "ошибка: " + ТекстОшибки;
			СтрокиЛога.Добавить(ПрефиксСтроки + "ОШИБКА — " + ТекстОшибки);
			Ошибок = Ошибок + 1;

		КонецПопытки;

	КонецЦикла;

	Итог = "Готово. Создано: " + Создано + ", пропущено: " + Пропущено
		+ ", ошибок: " + Ошибок;
	СтрокиЛога.Вставить(0, Итог);
	Лог = СтрСоединить(СтрокиЛога, Символы.ПС);

КонецПроцедуры

&НаСервереБезКонтекста
Функция РеализацияПоЗаказуСуществует(Знач ЗаказСсылка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Реализация.Ссылка КАК Реализация
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Реализация
	|ГДЕ
	|	Реализация.ЗаказКлиента = &Заказ
	|	И НЕ Реализация.Ссылка.ПометкаУдаления";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

&НаСервереБезКонтекста
Функция КраткаяОшибка()

	// Конкретика проведения/заполнения — в сообщениях пользователю; берём их,
	// иначе платформенное «Не удалось провести…» без причины.
	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Если Сообщения.Количество() > 0 Тогда
		Тексты = Новый Массив;
		Для Каждого Сообщение Из Сообщения Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		Возврат СтрСоединить(Тексты, "; ");
	КонецЕсли;

	Инфо = ИнформацияОбОшибке();
	Возврат ?(Инфо = Неопределено, "неизвестная ошибка", КраткоеПредставлениеОшибки(Инфо));

КонецФункции

#КонецОбласти
