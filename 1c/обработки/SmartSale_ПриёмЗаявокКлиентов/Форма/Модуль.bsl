// Модуль управляемой формы внешней обработки «SmartSale: приём заявок клиентов».
//
// АРМ менеджера: разбирает заявки агентов на новых клиентов (справочник
// SmartSale_ЗаявкиКлиентов, куда их кладёт обмен) и по отмеченным заводит
// ТИПОВЫЕ мастер-данные — Партнёр (Клиент) и связанный с ним Контрагент.
// Телефон и адрес пишутся штатным механизмом контактной информации
// (УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию). Координаты
// заявки кладём в комментарий партнёра — точная привязка к карте отдельно.
//
// Заявка НЕ несёт типа расширения в метаданных формы: обработка собирается на
// тестовой ERP, где справочника SmartSale_ЗаявкиКлиентов нет. Поэтому ссылку на
// заявку храним строкой (УИД) и разбираем ПолучитьСсылку уже в рабочей базе.
//
// Реквизиты формы (создать в Конфигураторе, см. README):
//   Лог     - Строка (многострочная, ТолькоПросмотр)
//   Заявки  - ТаблицаЗначений с колонками:
//       Пометка       - Булево
//       ЗаявкаУИД     - Строка (УИД элемента SmartSale_ЗаявкиКлиентов)
//       Наименование  - Строка (правится)
//       ИНН           - Строка (правится)
//       Телефон       - Строка (правится)
//       Адрес         - Строка (правится)
//       КонтактноеЛицо- Строка
//       Агент         - Строка (представление)
//       Координаты    - Строка
//       Комментарий   - Строка
//       Результат     - Строка

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЗаявкиНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьЗаявкиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьПометки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	УстановитьПометки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ЗавестиКлиентов(Команда)

	Отмеченных = 0;
	Для Каждого ТекЗаявка Из Заявки Цикл
		Если ТекЗаявка.Пометка Тогда
			Отмеченных = Отмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если Отмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одной заявки.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Завести клиентов по " + Отмеченных + " заявкам?"
		+ " Для каждого создаётся партнёр и контрагент.";
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавестиКлиентовЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗавестиКлиентовЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗавестиКлиентовНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Значение)

	Для Каждого ТекЗаявка Из Заявки Цикл
		ТекЗаявка.Пометка = Значение;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаявкиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	З.Ссылка КАК СсылкаЗаявки,
	|	З.Наименование КАК Наименование,
	|	З.ИНН КАК ИНН,
	|	З.Телефон КАК Телефон,
	|	З.Адрес КАК Адрес,
	|	З.КонтактноеЛицо КАК КонтактноеЛицо,
	|	З.Агент КАК Агент,
	|	З.Широта КАК Широта,
	|	З.Долгота КАК Долгота,
	|	З.Комментарий КАК Комментарий,
	|	З.ДатаЗаявки КАК ДатаЗаявки
	|ИЗ
	|	Справочник.SmartSale_ЗаявкиКлиентов КАК З
	|ГДЕ
	|	НЕ З.Обработана
	|	И НЕ З.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	З.ДатаЗаявки";

	Заявки.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = Заявки.Добавить();
		СтрокаТаблицы.Пометка = Ложь;
		СтрокаТаблицы.ЗаявкаУИД = Строка(Выборка.СсылкаЗаявки.УникальныйИдентификатор());
		СтрокаТаблицы.Наименование = СокрЛП(Выборка.Наименование);
		СтрокаТаблицы.ИНН = СокрЛП(Выборка.ИНН);
		СтрокаТаблицы.Телефон = СокрЛП(Выборка.Телефон);
		СтрокаТаблицы.Адрес = СокрЛП(Выборка.Адрес);
		СтрокаТаблицы.КонтактноеЛицо = СокрЛП(Выборка.КонтактноеЛицо);
		СтрокаТаблицы.Агент = Строка(Выборка.Агент);
		СтрокаТаблицы.Координаты = СоединитьКоординаты(Выборка.Широта, Выборка.Долгота);
		СтрокаТаблицы.Комментарий = Выборка.Комментарий;
		СтрокаТаблицы.Результат = "";
	КонецЦикла;

	Лог = "Заявок к разбору: " + Заявки.Количество();

КонецПроцедуры

&НаСервере
Процедура ЗавестиКлиентовНаСервере()

	Если НЕ РеквизитЗаявкиЕсть("КлиентСоздан") Тогда
		Лог = "Нет реквизита «КлиентСоздан» у справочника SmartSale_ЗаявкиКлиентов."
			+ " Добавьте его (тип СправочникСсылка.Партнеры) по инструкции README —"
			+ " без него заявку нельзя пометить исполненной.";
		Возврат;
	КонецЕсли;

	Создано = 0;
	Ошибок = 0;
	СтрокиЛога = Новый Массив;

	Для Каждого СтрокаТаблицы Из Заявки Цикл

		Если НЕ СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		ПрефиксСтроки = СтрокаТаблицы.Наименование + ": ";

		СозданныйПартнёр = Неопределено;
		РанееСозданный = "";
		УжеОбработана = Ложь;
		ПредупреждениеКИ = "";
		ТекстОшибки = "";

		// Всё, что трогает транзакцию, живёт внутри Попытки; формирование
		// результата и лога — строго ПОСЛЕ, чтобы исключение при сборке строки
		// не привело к повторному Отменить/Зафиксировать над закрытой транзакцией.
		Попытка

			НачатьТранзакцию();

			ЗаявкаСсылка = Справочники.SmartSale_ЗаявкиКлиентов.ПолучитьСсылку(
				Новый УникальныйИдентификатор(СтрокаТаблицы.ЗаявкаУИД));
			ЗаявкаОбъект = ЗаявкаСсылка.ПолучитьОбъект();

			Если ЗаявкаОбъект = Неопределено Тогда
				ВызватьИсключение "заявка не найдена в базе";
			КонецЕсли;

			Если ЗаявкаОбъект.Обработана Тогда
				УжеОбработана = Истина;
				РанееСозданный = Строка(ЗаявкаОбъект.КлиентСоздан);
				ОтменитьТранзакцию();
			Иначе
				ЕстьИНН = НЕ ПустаяСтрока(СокрЛП(СтрокаТаблицы.ИНН));

				// Партнёр — карточка клиента.
				ПартнерОбъект = Справочники.Партнеры.СоздатьЭлемент();
				ПартнерОбъект.Наименование = Лев(СокрЛП(СтрокаТаблицы.Наименование), 150);
				ПартнерОбъект.НаименованиеПолное = СокрЛП(СтрокаТаблицы.Наименование);
				ПартнерОбъект.Клиент = Истина;
				ПартнерОбъект.ОбслуживаетсяТорговымиПредставителями = Истина;
				ПартнерОбъект.ОсновнойМенеджер = ЗаявкаОбъект.Агент;
				ПартнерОбъект.ДатаРегистрации = НачалоДня(ТекущаяДатаСеанса());
				ПартнерОбъект.ЮрФизЛицо = ?(ЕстьИНН,
					Перечисления.КомпанияЧастноеЛицо.Компания,
					Перечисления.КомпанияЧастноеЛицо.ЧастноеЛицо);
				ПартнерОбъект.Комментарий = КомментарийПартнёра(СтрокаТаблицы);
				ПредупреждениеКИ = ЗаписатьКонтакты(ПартнерОбъект, СтрокаТаблицы, "Партнер");
				ПартнерОбъект.Записать();

				// Контрагент — юрлицо для документов, связан с партнёром.
				КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
				КонтрагентОбъект.Наименование = Лев(СокрЛП(СтрокаТаблицы.Наименование), 150);
				КонтрагентОбъект.НаименованиеПолное = СокрЛП(СтрокаТаблицы.Наименование);
				КонтрагентОбъект.Партнер = ПартнерОбъект.Ссылка;
				КонтрагентОбъект.ИНН = СокрЛП(СтрокаТаблицы.ИНН);
				КонтрагентОбъект.ЮридическоеФизическоеЛицо = ?(ЕстьИНН,
					Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо,
					Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);
				ПредупреждениеКИ = ПредупреждениеКИ
					+ ЗаписатьКонтакты(КонтрагентОбъект, СтрокаТаблицы, "Контрагент");
				КонтрагентОбъект.Записать();

				// Координаты заявки → гео-КИ контрагента тем же штатным механизмом,
				// что читают /customers и карта: новый клиент сразу встаёт на карту.
				// Некритично: нет видов координат в базе — клиент всё равно заведён,
				// координаты остаются в комментарии, предупреждение в протокол.
				ГеоШирота = СокрЛП(Строка(ЗаявкаОбъект.Широта));
				ГеоДолгота = СокрЛП(Строка(ЗаявкаОбъект.Долгота));
				Если НЕ ПустаяСтрока(ГеоШирота) И НЕ ПустаяСтрока(ГеоДолгота) Тогда
					Попытка
						SmartSale_Обмен.ЗаписатьКоординаты(КонтрагентОбъект.Ссылка, ГеоШирота, ГеоДолгота);
					Исключение
						ПредупреждениеКИ = ПредупреждениеКИ + "; координаты не записаны ("
							+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ")";
					КонецПопытки;
				КонецЕсли;

				// Отметить заявку исполненной.
				ЗаявкаОбъект.Обработана = Истина;
				ЗаявкаОбъект.КлиентСоздан = ПартнерОбъект.Ссылка;
				ЗаявкаОбъект.Записать();

				СозданныйПартнёр = ПартнерОбъект.Ссылка;

				ЗафиксироватьТранзакцию();
			КонецЕсли;

		Исключение

			ОтменитьТранзакцию();
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());

		КонецПопытки;

		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			СтрокаТаблицы.Результат = "ошибка: " + ТекстОшибки;
			СтрокиЛога.Добавить(ПрефиксСтроки + "ОШИБКА — " + ТекстОшибки);
			Ошибок = Ошибок + 1;
		ИначеЕсли УжеОбработана Тогда
			СтрокаТаблицы.Результат = "уже заведён: " + РанееСозданный;
			СтрокаТаблицы.Пометка = Ложь;
			СтрокиЛога.Добавить(ПрефиксСтроки + "пропущено — заявка уже обработана");
		Иначе
			СтрокаТаблицы.Результат = "заведён: " + Строка(СозданныйПартнёр)
				+ ?(ПустаяСтрока(ПредупреждениеКИ), "", " (" + СокрЛП(ПредупреждениеКИ) + ")");
			СтрокаТаблицы.Пометка = Ложь;
			СтрокиЛога.Добавить(ПрефиксСтроки + "создан партнёр и контрагент"
				+ ?(ПустаяСтрока(ПредупреждениеКИ), "", "; " + СокрЛП(ПредупреждениеКИ)));
			Создано = Создано + 1;
		КонецЕсли;

	КонецЦикла;

	// Список не перечитываем: заведённые остаются в таблице со статусом в
	// колонке «Результат», чтобы менеджер видел итог. Убрать их из списка —
	// кнопкой «Обновить».
	Итог = "Готово. Заведено: " + Создано + ", ошибок: " + Ошибок
		+ ". «Обновить» — убрать заведённых из списка.";
	СтрокиЛога.Вставить(0, Итог);
	Лог = СтрСоединить(СтрокиЛога, Символы.ПС);

КонецПроцедуры

// Записать телефон и адрес заявки в контактную информацию объекта штатным
// механизмом. Вид берём по типу владельца (Партнер/Контрагент). Некритично:
// если механизм КИ споткнётся, объект всё равно создаётся (контакт остаётся в
// комментарии партнёра), а вызывающий код получит текст предупреждения. Своя
// Попытка внутри — чтобы сбой КИ не откатывал транзакцию создания клиента.
&НаСервереБезКонтекста
Функция ЗаписатьКонтакты(ОбъектВладелец, СтрокаТаблицы, ТипВладельца)

	Телефон = СокрЛП(СтрокаТаблицы.Телефон);
	Адрес = СокрЛП(СтрокаТаблицы.Адрес);

	Попытка

		Если НЕ ПустаяСтрока(Телефон) Тогда
			ИмяВида = ?(ТипВладельца = "Контрагент", "ТелефонКонтрагента", "ТелефонПартнера");
			ВидКИ = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени(ИмяВида);
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектВладелец, Телефон, ВидКИ);
		КонецЕсли;

		Если НЕ ПустаяСтрока(Адрес) Тогда
			ИмяВида = ?(ТипВладельца = "Контрагент", "АдресКонтрагента", "АдресПартнера");
			ВидКИ = УправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени(ИмяВида);
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(ОбъектВладелец, Адрес, ВидКИ);
		КонецЕсли;

	Исключение

		Возврат "контакты " + НРег(ТипВладельца) + " не записаны ("
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "), см. комментарий";

	КонецПопытки;

	Возврат "";

КонецФункции

&НаСервереБезКонтекста
Функция КомментарийПартнёра(СтрокаТаблицы)

	Части = Новый Массив;
	Если НЕ ПустаяСтрока(СокрЛП(СтрокаТаблицы.КонтактноеЛицо)) Тогда
		Части.Добавить("Контакт: " + СокрЛП(СтрокаТаблицы.КонтактноеЛицо));
	КонецЕсли;
	Если НЕ ПустаяСтрока(СокрЛП(СтрокаТаблицы.Координаты)) Тогда
		Части.Добавить("Координаты: " + СокрЛП(СтрокаТаблицы.Координаты));
	КонецЕсли;
	Если НЕ ПустаяСтрока(СокрЛП(СтрокаТаблицы.Комментарий)) Тогда
		Части.Добавить(СокрЛП(СтрокаТаблицы.Комментарий));
	КонецЕсли;
	Части.Добавить("Заявка агента: " + СокрЛП(СтрокаТаблицы.Агент));
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Проверка, что у справочника заявок есть нужный реквизит. Даёт один понятный
// текст при раскатке вместо N криптованных «Поле объекта не обнаружено».
&НаСервереБезКонтекста
Функция РеквизитЗаявкиЕсть(Знач ИмяРеквизита)

	Возврат Метаданные.Справочники.SmartSale_ЗаявкиКлиентов.Реквизиты.Найти(ИмяРеквизита)
		<> Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция СоединитьКоординаты(Знач Широта, Знач Долгота)

	Ш = СокрЛП(Строка(Широта));
	Д = СокрЛП(Строка(Долгота));
	Если ПустаяСтрока(Ш) И ПустаяСтрока(Д) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ш + ", " + Д;

КонецФункции

#КонецОбласти
