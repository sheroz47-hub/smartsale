// Модуль управляемой формы внешней обработки «SmartSale: постановка заданий».
//
// АРМ супервайзера: массово ставит задания агенту по выбранным клиентам.
// Задание — ТИПОВОЙ документ «ЗаданиеТорговомуПредставителю» (шапка агент+
// клиент+дата визита+статус, ТЧ «Задачи» с описанием). Пишем программно
// (Записать без проведения): проверка заполнения при этом не запускается, а
// соглашения в базе выключены, поэтому документ создаётся минимальным набором
// полей. Каждый клиент — отдельной попыткой: ошибка одного не срывает остальные.
//
// Реквизиты формы (создать в Конфигураторе, см. README):
//   ДатаВизита         - Дата (состав Дата)
//   Агент              - СправочникСсылка.Пользователи
//   ОписаниеЗадачи     - Строка (многострочная) — текст задания
//   ОтборНаименования  - Строка — фильтр клиентов по имени
//   Лог                - Строка (многострочная, ТолькоПросмотр)
//   Клиенты            - ТаблицаЗначений с колонками:
//       Пометка     - Булево
//       Клиент      - СправочникСсылка.Партнеры
//       Наименование- Строка
//       Результат   - Строка

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаВизита = НачалоДня(ТекущаяДатаСеанса());

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьКлиентов(Команда)

	Если НЕ ЗначениеЗаполнено(Агент) Тогда
		ПоказатьПредупреждение(, "Укажите агента — по нему подбираются клиенты.");
		Возврат;
	КонецЕсли;
	ЗаполнитьКлиентовНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	УстановитьПометки(Истина);

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)

	УстановитьПометки(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ПоставитьЗадания(Команда)

	Если НЕ ЗначениеЗаполнено(СокрЛП(ОписаниеЗадачи)) Тогда
		ПоказатьПредупреждение(, "Заполните текст задания.");
		Возврат;
	КонецЕсли;

	Отмеченных = 0;
	Для Каждого Строка Из Клиенты Цикл
		Если Строка.Пометка Тогда
			Отмеченных = Отмеченных + 1;
		КонецЕсли;
	КонецЦикла;

	Если Отмеченных = 0 Тогда
		ПоказатьПредупреждение(, "Не отмечено ни одного клиента.");
		Возврат;
	КонецЕсли;

	ТекстВопроса = "Поставить задание " + Отмеченных + " клиентам агента "
		+ Строка(Агент) + "?";
	ОписаниеОповещения = Новый ОписаниеОповещения("ПоставитьЗаданияЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПоставитьЗаданияЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоставитьЗаданияНаСервере();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Значение)

	Для Каждого Строка Из Клиенты Цикл
		Строка.Пометка = Значение;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКлиентовНаСервере()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Агент", Агент);
	Запрос.УстановитьПараметр("БезФильтраИмени", НЕ ЗначениеЗаполнено(СокрЛП(ОтборНаименования)));
	Запрос.УстановитьПараметр("Шаблон", "%" + СокрЛП(ОтборНаименования) + "%");
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Ссылка КАК Клиент,
	|	П.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Партнеры КАК П
	|ГДЕ
	|	П.Клиент
	|	И НЕ П.ПометкаУдаления
	|	И П.ОсновнойМенеджер = &Агент
	|	И (&БезФильтраИмени ИЛИ П.Наименование ПОДОБНО &Шаблон)
	|УПОРЯДОЧИТЬ ПО
	|	П.Наименование";

	Клиенты.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТаблицы = Клиенты.Добавить();
		СтрокаТаблицы.Клиент = Выборка.Клиент;
		СтрокаТаблицы.Наименование = Выборка.Наименование;
		СтрокаТаблицы.Пометка = Ложь;
		СтрокаТаблицы.Результат = "";
	КонецЦикла;

	Лог = "Найдено клиентов: " + Клиенты.Количество();

КонецПроцедуры

&НаСервере
Процедура ПоставитьЗаданияНаСервере()

	ТекстЗадания = СокрЛП(ОписаниеЗадачи);
	Создано = 0;
	Ошибок = 0;
	СтрокиЛога = Новый Массив;

	Для Каждого СтрокаТаблицы Из Клиенты Цикл

		Если НЕ СтрокаТаблицы.Пометка Тогда
			Продолжить;
		КонецЕсли;

		ПрефиксСтроки = СтрокаТаблицы.Наименование + ": ";

		Попытка

			НачатьТранзакцию();

			ДокОбъект = Документы.ЗаданиеТорговомуПредставителю.СоздатьДокумент();
			// Заполнить(Неопределено) инициализирует умолчания (организация,
			// склад, валюта, куратор), не трогая партнёра — его ставим ниже.
			ДокОбъект.Заполнить(Неопределено);
			ДокОбъект.Дата = ТекущаяДатаСеанса();
			ДокОбъект.ТорговыйПредставитель = Агент;
			ДокОбъект.Партнер = СтрокаТаблицы.Клиент;
			ДокОбъект.ДатаВизитаПлан = ДатаВизита;
			ДокОбъект.Статус = Перечисления.СтатусыЗаданийТорговымПредставителям.КОтработке;

			СтрокаЗадачи = ДокОбъект.Задачи.Добавить();
			СтрокаЗадачи.ОписаниеЗадачи = ТекстЗадания;
			СтрокаЗадачи.Выполнена = Ложь;

			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);

			ЗафиксироватьТранзакцию();

			НомерЗадания = ДокОбъект.Номер;
			СтрокаТаблицы.Результат = "задание " + НомерЗадания;
			СтрокиЛога.Добавить(ПрефиксСтроки + "создано задание " + НомерЗадания);
			Создано = Создано + 1;

		Исключение

			ОтменитьТранзакцию();
			ТекстОшибки = КраткаяОшибка();
			СтрокаТаблицы.Результат = "ошибка: " + ТекстОшибки;
			СтрокиЛога.Добавить(ПрефиксСтроки + "ОШИБКА — " + ТекстОшибки);
			Ошибок = Ошибок + 1;

		КонецПопытки;

	КонецЦикла;

	Итог = "Готово. Создано: " + Создано + ", ошибок: " + Ошибок;
	СтрокиЛога.Вставить(0, Итог);
	Лог = СтрСоединить(СтрокиЛога, Символы.ПС);

КонецПроцедуры

&НаСервереБезКонтекста
Функция КраткаяОшибка()

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Если Сообщения.Количество() > 0 Тогда
		Тексты = Новый Массив;
		Для Каждого Сообщение Из Сообщения Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		Возврат СтрСоединить(Тексты, "; ");
	КонецЕсли;

	Инфо = ИнформацияОбОшибке();
	Возврат ?(Инфо = Неопределено, "неизвестная ошибка", КраткоеПредставлениеОшибки(Инфо));

КонецФункции

#КонецОбласти
